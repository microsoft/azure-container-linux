#!/bin/bash
# 
# Minimal update-ssh-keys replacement for Azure Linux Container Linux
# Provides only the sync functionality needed by coreos-metadata-sshkeys@core.service
#

set -euo pipefail

USER=""

usage() {
    cat << 'EOF'
update-ssh-keys

Regenerate SSH authorized_keys file from authorized_keys.d directory.

OPTIONS:
    -u, --user <USERNAME>     Update the given user's authorized_keys file [default: core]
    -h, --help                Print help information

This tool regenerates ~/.ssh/authorized_keys from files in ~/.ssh/authorized_keys.d/
EOF
}

error_exit() {
    echo "Error: $*" >&2
    exit 1
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -u|--user)
            USER="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            error_exit "Unknown option $1"
            ;;
    esac
done

# Default user to core
if [[ -z "$USER" ]]; then
    USER="core"
fi

# Validate user exists
if ! getent passwd "$USER" > /dev/null 2>&1; then
    error_exit "User '$USER' not found"
fi

# Get user home directory and set paths
USER_HOME=$(getent passwd "$USER" | cut -d: -f6)
SSH_DIR="$USER_HOME/.ssh"
KEYS_DIR="$SSH_DIR/authorized_keys.d"
KEYS_FILE="$SSH_DIR/authorized_keys"

# Ensure SSH directory structure exists
mkdir -p "$KEYS_DIR"
chmod 700 "$SSH_DIR" 2>/dev/null || true
chmod 755 "$KEYS_DIR" 2>/dev/null || true

# Regenerate authorized_keys file from authorized_keys.d
temp_file=$(mktemp)
echo "# auto-generated by update-ssh-keys" > "$temp_file"

# Process all files in authorized_keys.d
if [[ -d "$KEYS_DIR" ]]; then
    for keyfile in "$KEYS_DIR"/*; do
        if [[ -f "$keyfile" && -s "$keyfile" ]]; then
            cat "$keyfile" >> "$temp_file"
        fi
    done
fi

# Update authorized_keys file
mv "$temp_file" "$KEYS_FILE"
chmod 600 "$KEYS_FILE"

# Change ownership if running as root
if [[ "$EUID" -eq 0 ]] && [[ "$USER" != "root" ]]; then
    chown "$USER:$USER" "$SSH_DIR" "$KEYS_DIR" "$KEYS_FILE" 2>/dev/null || true
fi

echo "Updated $KEYS_FILE"