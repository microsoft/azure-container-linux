#!/bin/bash
#
# update-ssh-keys replacement for Azure Container Linux
# Compatible with Flatcar's Rust-based update-ssh-keys interface.
# Supports add (-a), force-add (-A), delete (-d), disable (-D),
# list (-l), no-replace (-n), and key regeneration.
#

set -euo pipefail

USER=""
ACTION=""       # add, force-add, delete, disable, list, or empty (regen only)
IDENTIFIER=""
NO_REPLACE=false
SSH_DIR_OVERRIDE=""

usage() {
    cat << 'EOF'
update-ssh-keys [OPTIONS] [KEY_FILES...]

Manage SSH authorized keys for a user via authorized_keys.d directory.

If -a, -A, -d, nor -D are provided, then the authorized_keys file is
simply regenerated using the existing keys.

When using -a or -A, keys must be provided as files on the command line,
or if no files are given, via standard input.

OPTIONS:
    -u, --user <USER>         Update the given user's authorized_keys [default: core]
    -a, --add <NAME>          Add keys from files/stdin under the given identifier
    -A, --add-force <NAME>    Add keys even if the identifier was disabled with -D
    -d, --delete <NAME>       Delete keys stored under the given identifier
    -D, --disable <NAME>      Delete keys and prevent further addition with -a
    -n, --no-replace          When adding, don't replace an existing key with the given name
    -l, --list                List the names and number of keys currently installed
        --ssh-dir <DIR>       SSH directory override [default: ~/.ssh]
    -h, --help                Print help information
EOF
}

error_exit() {
    echo "Error: $*" >&2
    exit 1
}

# Parse command line arguments
KEY_FILES=()
while [[ $# -gt 0 ]]; do
    case $1 in
        -u|--user)
            [[ $# -ge 2 ]] || error_exit "Missing value for $1"
            USER="$2"
            shift 2
            ;;
        -a|--add)
            [[ $# -ge 2 ]] || error_exit "Missing value for $1"
            ACTION="add"
            IDENTIFIER="$2"
            shift 2
            ;;
        -A|--add-force)
            [[ $# -ge 2 ]] || error_exit "Missing value for $1"
            ACTION="force-add"
            IDENTIFIER="$2"
            shift 2
            ;;
        -d|--delete)
            [[ $# -ge 2 ]] || error_exit "Missing value for $1"
            ACTION="delete"
            IDENTIFIER="$2"
            shift 2
            ;;
        -D|--disable)
            [[ $# -ge 2 ]] || error_exit "Missing value for $1"
            ACTION="disable"
            IDENTIFIER="$2"
            shift 2
            ;;
        -n|--no-replace)
            NO_REPLACE=true
            shift
            ;;
        -l|--list)
            ACTION="list"
            shift
            ;;
        --ssh-dir)
            [[ $# -ge 2 ]] || error_exit "Missing value for $1"
            SSH_DIR_OVERRIDE="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            error_exit "Unknown option $1"
            ;;
        *)
            KEY_FILES+=("$1")
            shift
            ;;
    esac
done

# Default user to core
if [[ -z "$USER" ]]; then
    USER="core"
fi

# Validate user exists
if ! getent passwd "$USER" > /dev/null 2>&1; then
    error_exit "User '$USER' not found"
fi

# Get user home directory and set paths
USER_HOME=$(getent passwd "$USER" | cut -d: -f6)
if [[ -n "$SSH_DIR_OVERRIDE" ]]; then
    SSH_DIR="$SSH_DIR_OVERRIDE"
else
    SSH_DIR="$USER_HOME/.ssh"
fi
KEYS_DIR="$SSH_DIR/authorized_keys.d"
KEYS_FILE="$SSH_DIR/authorized_keys"
DISABLED_DIR="$KEYS_DIR/.disabled"

# Ensure SSH directory structure exists
mkdir -p "$KEYS_DIR"
chmod 700 "$SSH_DIR" 2>/dev/null || true
chmod 755 "$KEYS_DIR" 2>/dev/null || true

# Regenerate authorized_keys from authorized_keys.d
regenerate() {
    local temp_file
    temp_file=$(mktemp)
    echo "# auto-generated by update-ssh-keys" > "$temp_file"

    if [[ -d "$KEYS_DIR" ]]; then
        for keyfile in "$KEYS_DIR"/*; do
            if [[ -f "$keyfile" && -s "$keyfile" ]]; then
                cat "$keyfile" >> "$temp_file"
                # Ensure trailing newline
                [[ "$(tail -c1 "$temp_file")" == "" ]] || echo >> "$temp_file"
            fi
        done
    fi

    mv "$temp_file" "$KEYS_FILE"
    chmod 600 "$KEYS_FILE"

    # Fix ownership if running as root
    if [[ "$EUID" -eq 0 ]] && [[ "$USER" != "root" ]]; then
        chown "$USER:$USER" "$SSH_DIR" "$KEYS_DIR" "$KEYS_FILE" 2>/dev/null || true
        if [[ -d "$DISABLED_DIR" ]]; then
            chown "$USER:$USER" "$DISABLED_DIR" 2>/dev/null || true
        fi
    fi
}

case "${ACTION}" in
    add|force-add)
        key_file="$KEYS_DIR/$IDENTIFIER"

        # Check if disabled (unless force-add)
        if [[ "$ACTION" == "add" ]] && [[ -f "$DISABLED_DIR/$IDENTIFIER" ]]; then
            echo "Skipping add for '$IDENTIFIER', disabled."
            exit 0
        fi

        # Check no-replace
        if [[ "$NO_REPLACE" == true ]] && [[ -f "$key_file" ]]; then
            echo "Key '$IDENTIFIER' already exists, skipping (no-replace)."
            regenerate
            echo "Updated $KEYS_FILE"
            exit 0
        fi

        # Remove disabled marker if force-adding
        if [[ "$ACTION" == "force-add" ]] && [[ -f "$DISABLED_DIR/$IDENTIFIER" ]]; then
            rm -f "$DISABLED_DIR/$IDENTIFIER"
        fi

        # Read keys from files or stdin
        temp_key=$(mktemp)
        if [[ ${#KEY_FILES[@]} -gt 0 ]]; then
            for f in "${KEY_FILES[@]}"; do
                if [[ -f "$f" ]]; then
                    cat "$f" >> "$temp_key"
                else
                    rm -f "$temp_key"
                    error_exit "Key file '$f' not found"
                fi
            done
        else
            # Read from stdin
            cat > "$temp_key"
        fi

        if [[ ! -s "$temp_key" ]]; then
            rm -f "$temp_key"
            error_exit "No keys provided"
        fi

        mv "$temp_key" "$key_file"
        chmod 644 "$key_file"
        echo "Adding/updating $IDENTIFIER:"
        while IFS= read -r line; do
            [[ -n "$line" ]] && echo "  $line"
        done < "$key_file"

        regenerate
        echo "Updated $KEYS_FILE"
        ;;

    delete)
        key_file="$KEYS_DIR/$IDENTIFIER"
        if [[ -f "$key_file" ]]; then
            echo "Removing $IDENTIFIER"
            rm -f "$key_file"
        else
            echo "Key '$IDENTIFIER' not found"
        fi
        regenerate
        echo "Updated $KEYS_FILE"
        ;;

    disable)
        key_file="$KEYS_DIR/$IDENTIFIER"
        mkdir -p "$DISABLED_DIR"
        if [[ -f "$key_file" ]]; then
            echo "Disabling $IDENTIFIER"
            rm -f "$key_file"
        fi
        touch "$DISABLED_DIR/$IDENTIFIER"
        regenerate
        echo "Updated $KEYS_FILE"
        ;;

    list)
        if [[ -d "$KEYS_DIR" ]]; then
            for keyfile in "$KEYS_DIR"/*; do
                if [[ -f "$keyfile" && -s "$keyfile" ]]; then
                    name=$(basename "$keyfile")
                    count=$(grep -c '' "$keyfile" 2>/dev/null || echo 0)
                    echo "$name: $count"
                fi
            done
        fi
        ;;

    "")
        # No action specified — just regenerate
        regenerate
        echo "Updated $KEYS_FILE"
        ;;
esac
