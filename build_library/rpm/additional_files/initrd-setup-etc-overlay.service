[Unit]
Description=Set up /etc overlay for Flatcar RPM mode
DefaultDependencies=no
# Run after root filesystem is fully mounted and ready
# sysroot.mount is the actual mount unit for /sysroot
After=sysroot.mount initrd-root-fs.target
Requires=sysroot.mount
Before=initrd-switch-root.target initrd-parse-etc.service
# Don't fail boot if this fails
OnFailure=
# Only run if our flatcar etc exists
ConditionPathExists=/sysroot/usr/share/flatcar/etc

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/flatcar-etc-overlay
StandardOutput=journal+console
StandardError=journal+console
