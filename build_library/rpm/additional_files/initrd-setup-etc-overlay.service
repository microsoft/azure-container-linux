[Unit]
Description=Set up /etc overlay for RPM build mode
DefaultDependencies=no

# Run after root filesystem AND /usr are mounted
# /usr is mounted at /sysusr/usr in initrd (not /sysroot/usr)
After=sysroot.mount sysusr-usr.mount initrd-root-fs.target ignition-mount.service
Requires=sysroot.mount
Wants=sysusr-usr.mount

# CRITICAL: Must run BEFORE ignition-files.service which creates users
# ignition-files needs to write to /sysroot/etc/passwd, /etc/group, etc.
Before=ignition-files.service
Before=initrd-switch-root.target initrd-parse-etc.service

# Don't fail boot if this fails (allow fallback)
OnFailure=

# Check for etc in the correct location (/sysusr/usr, not /sysroot/usr)
ConditionPathExists=/sysusr/usr/share/flatcar/etc

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/etc-overlay
StandardOutput=journal+console
StandardError=journal+console
