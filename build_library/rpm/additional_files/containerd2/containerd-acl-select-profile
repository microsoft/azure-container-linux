#!/bin/bash

set -euo pipefail

base_config="${1:-}"
erofs_config="${ACL_CONTAINERD_EROFS_CONFIG:-/usr/share/containerd/acl-erofs.toml}"
final_config="${ACL_CONTAINERD_CONFIG_PATH:-/run/containerd/acl-config.toml}"
ipe_dir="${ACL_IPE_DIR:-/sys/kernel/security/ipe}"

fail() { echo "ERROR: $*" >&2; exit 1; }

[[ -n "${base_config}" && -r "${base_config}" ]] ||
    fail "containerd base config is not readable: ${base_config}"

# Convert a given path to an absolute path and escape it for use in a TOML file.
get_absolute_path() {
    local path="$1"
    [[ "${path}" == /* ]] || path="$(pwd)/${path}"
    path="${path//\\/\\\\}"
    path="${path//\"/\\\"}"
    printf '"%s"' "${path}"
}

write_config() {
    {
        printf 'version = 4\nimports = ['
        get_absolute_path "${base_config}"
        if [[ "$1" == "erofs" ]]; then
            printf ', '
            get_absolute_path "${erofs_config}"
        fi
        printf ']\n'
    } > "${temporary_merged_config}"
}

# Make sure containerd's supported features include dmverity referrer support by inspecting the default configuration for enable_dmverity_referrers.
check_referrer_support() {
    local defaults="$1"
    if ! grep -Eq '^[[:space:]]*enable_dmverity_referrers[[:space:]]*=' <<< "${defaults}"; then
        echo "WARNING: containerd does not support enable_dmverity_referrers" >&2
        return 1
    fi
}

# Ensure CRI selects the EROFS snapshotter with referrer discovery and the EROFS differ.
check_erofs_settings() {
    local config="$1"
    awk '
        {
            gsub(/\047/, "\"")
            sub(/^[[:space:]]+/, "")
            sub(/[[:space:]]+$/, "")
        }

        /^\[/ {
            section = $0
        }

        # Check if the EROFS snapshotter or differ is explicitly disabled in the configuration.
        !section && /^disabled_plugins =/ && /"io\.containerd\.(snapshotter|differ)\.v1\.erofs"/ {
            print "WARNING: the EROFS snapshotter or differ is explicitly disabled" > "/dev/stderr"
            config_conflict = 1
        }

        # Required dmverity referrer and EROFS settings.
        section == "[plugins.\"io.containerd.snapshotter.v1.erofs\"]" &&
            /^enable_dmverity_referrers =/ {
                referrers_enabled = ($0 == "enable_dmverity_referrers = true")
            }

        section == "[plugins.\"io.containerd.cri.v1.images\"]" &&
            /^snapshotter =/ {
                erofs_snapshotter_selected = ($0 == "snapshotter = \"erofs\"")
            }

        section == "[plugins.\"io.containerd.service.v1.diff-service\"]" &&
            /^default =/ {
                erofs_differ_selected = ($0 == "default = [\"erofs\", \"walking\"]")
            }

        section == "[plugins.\"io.containerd.snapshotter.v1.erofs\"]" &&
            $0 == "dmverity_mode = \"off\"" {
                print "WARNING: dmverity_mode = off prevents signed EROFS snapshotter startup" > "/dev/stderr"
                config_conflict = 1
            }

        END {
            if (!referrers_enabled ||
                !erofs_snapshotter_selected ||
                !erofs_differ_selected) {
                print "WARNING: merged config does not retain the required EROFS settings." > "/dev/stderr"
                exit 1
            }
            if (config_conflict) exit 1
        }
    ' <<< "${config}"
}

# A download concurrency value that deviates from containerd's default value configures the CRI
# to use local pulls, bypassing the Transfer service path required for pulling referrers.
check_download_compatibility() {
    local config="$1" defaults="$2" default_downloads
    if ! default_downloads="$(awk '
        {
            gsub(/\047/, "\"")
            sub(/^[[:space:]]+/, "")
            sub(/[[:space:]]+$/, "")
        }
        /^\[/ { section = $0 }
        section == "[plugins.\"io.containerd.cri.v1.images\"]" &&
            /^max_concurrent_downloads =/ && $3 ~ /^-?[0-9]+$/ {
                value = $3
                found = 1
            }
        END {
            if (!found) exit 1
            print value
        }
    ' <<< "${defaults}")"; then
        echo "WARNING: cannot determine containerd's CRI download compatibility default" >&2
        return 1
    fi

    # Check if the max_concurrent_downloads deviates from the default
    awk -v default_downloads="${default_downloads}" '
        {
            gsub(/\047/, "\"")
            sub(/^[[:space:]]+/, "")
            sub(/[[:space:]]+$/, "")
        }
        /^\[/ { section = $0 }
        section == "[plugins.\"io.containerd.cri.v1.images\"]" &&
            /^max_concurrent_downloads =/ &&
            $0 != "max_concurrent_downloads = " default_downloads {
                print "WARNING: " $0 " prevents use of the Transfer service required by signed EROFS image pulls" > "/dev/stderr"
                exit 1
            }
    ' <<< "${config}"
}

# If there is an entry for the transfer service's unpack_config, there must be a section setting both the EROFS snapshotter and differ.
# Additionally, if platform checks are enabled (check_platform_supported), that entry must also match the host architecture.
check_unpack_config() {
    local config="$1" host_arch
    host_arch="$(uname -m)" || return 1
    case "${host_arch}" in
        x86_64) host_arch=amd64 ;;
        aarch64) host_arch=arm64 ;;
    esac

    awk -v host_arch="${host_arch}" '
        function check_entry() {
            if (in_unpack_entry && snapshotter && differ &&
                (!check_platform_supported || platform_arch == host_arch)) valid_erofs_entry = 1
        }
        {
            gsub(/\047/, "\"")
            sub(/^[[:space:]]+/, "")
            sub(/[[:space:]]+$/, "")
        }
        /^\[/ {
            check_entry()
            section = $0
            in_unpack_entry = ($0 == "[[plugins.\"io.containerd.transfer.v1.local\".unpack_config]]")
            if (in_unpack_entry) {
                has_unpack_config = 1
                snapshotter = differ = 0
                platform_arch = ""
            }
        }
        # Check if the current section is the transfer service and look for the check_platform_supported setting
        section == "[plugins.\"io.containerd.transfer.v1.local\"]" && /^check_platform_supported =/ {
            check_platform_supported = ($0 == "check_platform_supported = true")
        }

        # Look for a platform entry if in an unpack_config section
        in_unpack_entry && /^platform =/ {
            split($3, platform, "/")
            platform_arch = platform[2]
            gsub(/"/, "", platform_arch)
        }

        # If in an unpack_config entry, look for the snapshotter and differ settings
        in_unpack_entry && /^snapshotter =/ {
            snapshotter = ($0 == "snapshotter = \"erofs\"")
        }
        in_unpack_entry && /^differ =/ {
            differ = ($0 == "differ = \"erofs\"")
        }
        END {
            check_entry()
            if (has_unpack_config && !valid_erofs_entry) {
                print "WARNING: explicit Transfer unpack_config has no compatible entry selecting both the erofs snapshotter and differ" > "/dev/stderr"
                exit 1
            }
        }
    ' <<< "${config}"
}

# These CRI options and legacy registry entries force local pulls, bypassing the Transfer service
# required for referrer pulls. These options cannot be set when using the EROFS referrer profile.
check_transfer_service_conflicts() {
    local config="$1"
    awk '
        function referrer_config_conflict(setting) {
            print "WARNING: " setting " prevents use of the Transfer service required by signed EROFS image pulls" > "/dev/stderr"
            config_conflict = 1
        }

        {
            gsub(/\047/, "\"")
            sub(/^[[:space:]]+/, "")
            sub(/[[:space:]]+$/, "")
        }
        /^\[/ { section = $0 }
        section == "[plugins.\"io.containerd.cri.v1.images\"]" &&
            ($0 == "use_local_image_pull = true" ||
             $0 == "disable_snapshot_annotations = false" ||
             $0 == "discard_unpacked_layers = true" ||
             $0 == "image_pull_with_sync_fs = true") {
                referrer_config_conflict($0)
            }

        # Entries in legacy registry tables force local pulls.
        /^\[plugins\."io\.containerd\.cri\.v1\.images"\.registry\.(mirrors|configs|auths)\./ {
            referrer_config_conflict($0)
        }

        END { if (config_conflict) exit 1 }
    ' <<< "${config}"
}

# Run the 'containerd config dump' command to get the fully merged configuration of the base and EROFS profile.
# The checks below ensure the merged config is valid and does not contain compatibility issues.
validate_erofs_profile() {
    local defaults merged

    # Read the default config options to see what the containerd binary supports.
    if ! defaults="$(containerd config default)"; then
        echo "WARNING: cannot read the containerd default configuration" >&2
        return 1
    fi
    check_referrer_support "${defaults}" || return 1

    if ! merged="$(containerd --config "${temporary_merged_config}" config dump)"; then
        echo "WARNING: cannot load the merged EROFS containerd configuration" >&2
        return 1
    fi

    check_erofs_settings "${merged}" || return 1
    check_download_compatibility "${merged}" "${defaults}" || return 1
    check_transfer_service_conflicts "${merged}" || return 1
    check_unpack_config "${merged}" || return 1
}

mkdir -p "$(dirname "${final_config}")"
temporary_merged_config="${final_config}.tmp.$$"
trap 'rm -f -- "${temporary_merged_config}"' EXIT

write_config erofs
selected_profile="EROFS"
if ! validate_erofs_profile; then
    # If IPE is enforcing or another unknown state, fail out immediately.
    if ! enforcement="$(tr -d '[:space:]' < "${ipe_dir}/enforce")" ||
        [[ "${enforcement}" != "0" ]]; then
        fail "IPE enforcement is not in audit mode. Refusing to use the base profile fallback."
    fi

    # If IPE is in audit mode, fall back to the base profile and continue with potential audit logs
    selected_profile="base"
    write_config base
    echo "WARNING: selected the base containerd config without dmverity referrer support for IPE audit mode. The signed EROFS profile was not activated" >&2
fi

mv -Tf "${temporary_merged_config}" "${final_config}"
echo "Selected ${selected_profile} containerd runtime profile. (base: ${base_config})" >&2
echo "Final config: ${final_config}" >&2
cat "${final_config}" >&2
