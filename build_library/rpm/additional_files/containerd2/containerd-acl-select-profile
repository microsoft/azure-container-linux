#!/bin/bash

set -euo pipefail

base_config="${1:-}"
config_path="${ACL_CONTAINERD_CONFIG_PATH:-/run/containerd/acl-config.toml}"

if [[ -z "${base_config}" || ! -r "${base_config}" ]]; then
    echo "ERROR: containerd base config is not readable: ${base_config}" >&2
    exit 1
fi

mkdir -p "$(dirname "${config_path}")"
temporary_config="${config_path}.tmp.$$"
trap 'rm -f -- "${temporary_config}"' EXIT
# Native dumping resolves and migrates the complete base import graph first.
# Replace only its normalized root imports, so nested files cannot undo the profile.
if ! containerd --config "${base_config}" config dump |
    awk '
        /^imports = / {
            print "imports = [\"/usr/share/containerd2/acl-erofs.toml\"]"
            found++
            next
        }
        { print }
        END { if (found != 1) exit 1 }
    ' > "${temporary_config}"; then
    echo "ERROR: failed to resolve containerd base config at ${base_config}" >&2
    exit 1
fi
mv -Tf "${temporary_config}" "${config_path}"
trap - EXIT

echo "Selected EROFS containerd runtime profile (base: ${base_config})"
