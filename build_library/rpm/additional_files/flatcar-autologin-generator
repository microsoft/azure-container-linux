#!/bin/bash
# Flatcar autologin generator
# Creates getty autologin drop-ins if flatcar.autologin is on kernel cmdline
#
# systemd generator that runs early in boot to conditionally enable
# autologin for serial and VGA consoles.
#
# Usage: Add flatcar.autologin to kernel cmdline to enable root autologin

set -euo pipefail

# Generator output directories (passed as arguments by systemd)
NORMAL_DIR="${1:-/tmp}"
# EARLY_DIR="$2"  # Not used
# LATE_DIR="$3"   # Not used

# Check if flatcar.autologin is on the kernel command line
if ! grep -q '\bflatcar\.autologin\b' /proc/cmdline; then
    # Not enabled, exit without creating drop-ins
    exit 0
fi

# Create autologin drop-in for serial-getty@.service template
# This applies to all serial consoles (ttyS0, ttyS1, etc.)
SERIAL_DROPIN_DIR="${NORMAL_DIR}/serial-getty@.service.d"
mkdir -p "${SERIAL_DROPIN_DIR}"
cat > "${SERIAL_DROPIN_DIR}/autologin.conf" << 'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --noclear --keep-baud %I 115200,38400,9600 $TERM
EOF

# Create autologin drop-in for getty@.service template
# This applies to all VGA consoles (tty1, tty2, etc.)
GETTY_DROPIN_DIR="${NORMAL_DIR}/getty@.service.d"
mkdir -p "${GETTY_DROPIN_DIR}"
cat > "${GETTY_DROPIN_DIR}/autologin.conf" << 'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin root --noclear %I $TERM
EOF

exit 0
