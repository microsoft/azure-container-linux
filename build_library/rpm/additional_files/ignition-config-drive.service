[Unit]
Description=Import Ignition config from config drive
DefaultDependencies=no

# Run after basic.target (which ensures generators have run and /run/ignition.env exists)
# but before ignition-fetch-offline which is the first ignition stage that reads config
After=basic.target
After=systemd-udevd.service
Wants=systemd-udevd.service

# Must run before ignition services
Before=ignition-fetch-offline.service
Before=ignition-fetch.service

# Only run on first boot when ignition is expected
ConditionKernelCommandLine=ignition.firstboot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ignition-config-drive
TimeoutSec=60

[Install]
WantedBy=ignition-complete.target
