#!/bin/bash
# Mangle script for the nvidia-driver sysext.
#
# systemd-sysext only merges /usr (and /opt), so build_sysext strips
# everything outside /usr after this script runs.  We relocate files
# from /bin, /sbin, /lib, /lib64, and /etc into /usr before that.

set -euo pipefail

SYSEXT_NAME="nvidia-driver"
STASH_DIR="/usr/share/${SYSEXT_NAME}/etc"
TMPFILES_CONF="/usr/lib/tmpfiles.d/${SYSEXT_NAME}-etc.conf"

cd "$1"   # work relative to the sysext rootfs

# ── Helpers ──────────────────────────────────────────────────────────────

merge_tree() {   # src dst – move whole tree, no-op if absent
    [[ -d ".$1" ]] || return 0
    mkdir -p ".$2"
    cp -a ".$1/." ".$2/"
    rm -rf ".$1"
}

tmpfiles_rule() {   # line – append to the tmpfiles.d conf
    mkdir -p ".$(dirname "${TMPFILES_CONF}")"
    echo "$1" >> ".${TMPFILES_CONF}"
}

relocate_etc() {   # rel dst_base [symlink] – move ./etc/$rel → ./$dst_base/$rel
    local rel="$1" dst="$2" link="${3:-}"
    mkdir -p ".${dst}/$(dirname "$rel")"
    mv "./etc/${rel}" ".${dst}/$(dirname "$rel")/"
    if [[ -n "$link" ]]; then
        tmpfiles_rule "L+ /etc/${rel} - - - - ${dst}/${rel}"
    fi
}

# ── 1. Merge top-level dirs into /usr ────────────────────────────────────

merge_tree /bin   /usr/bin
merge_tree /sbin  /usr/sbin
merge_tree /lib   /usr/lib
merge_tree /lib64 /usr/lib64

# ── 2. Relocate /etc into /usr ──────────────────────────────────────────

rm -f ./etc/ld.so.cache   # build artifact, regenerated at boot

if [[ -d ./etc ]]; then
    ( cd ./etc && find . -type f -o -type l ) | sed 's|^\./||' | sort \
    | while read -r rel; do
        case "$rel" in
            modprobe.d/*)  relocate_etc "$rel" /usr/lib       symlink ;;  # + symlink for hardcoded paths
            systemd/*)     relocate_etc "$rel" /usr/lib               ;;  # native search path, no symlink
            *)             relocate_etc "$rel" "${STASH_DIR}"  symlink ;;  # everything else
        esac
    done
    rm -rf ./etc
fi
