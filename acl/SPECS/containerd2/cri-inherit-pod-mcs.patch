+func containerSELinuxLabelOptions(securityContext *runtime.LinuxContainerSecurityContext, sandboxLabel string) ([]string, error) {
+	selinuxOptions := securityContext.GetSelinuxOptions()
+	options, err := toLabel(selinuxOptions)
+	if err != nil {
+		return nil, err
+	}
+	if len(options) == 0 {
+		return selinux.DupSecOpt(sandboxLabel)
+	}
+	if securityContext.GetPrivileged() || selinuxOptions.GetType() == "" ||
+		selinuxOptions.GetUser() != "" || selinuxOptions.GetRole() != "" ||
+		selinuxOptions.GetLevel() != "" {
+		return options, nil
+	}
+
+	// A type-only override must not allocate a different MCS level from the
+	// sandbox whose shared files the container needs to access.
+	context, err := selinux.NewContext(sandboxLabel)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse sandbox SELinux label %q: %w", sandboxLabel, err)
+	}
+	if level := context["level"]; level != "" {
+		options = append(options, "level:"+level)
+	}
+	return options, nil
+}
+
 func toLabel(selinuxOptions *runtime.SELinuxOption) ([]string, error) {
 	var labels []string
 
