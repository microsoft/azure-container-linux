+)
+
+func TestContainerMCSInheritance(t *testing.T) {
+	const podLabel = "system_u:system_r:container_t:s0:c347,c891"
+	for _, test := range []struct {
+		name       string
+		options    *runtime.SELinuxOption
+		privileged bool
+		expected   []string
+	}{
+		{name: "default", expected: []string{"user:system_u", "role:system_r", "type:container_t", "level:s0:c347,c891"}},
+		{name: "type only", options: &runtime.SELinuxOption{Type: "container_logreader_t"},
+			expected: []string{"type:container_logreader_t", "level:s0:c347,c891"}},
+		{name: "explicit level", options: &runtime.SELinuxOption{Type: "container_logreader_t", Level: "s0:c12,c34"},
+			expected: []string{"type:container_logreader_t", "level:s0:c12,c34"}},
+		{name: "explicit s0", options: &runtime.SELinuxOption{Type: "container_t", Level: "s0"},
+			expected: []string{"type:container_t", "level:s0"}},
+		{name: "privileged", privileged: true, options: &runtime.SELinuxOption{Type: "container_t"},
+			expected: []string{"type:container_t"}},
+		{name: "user override", options: &runtime.SELinuxOption{Type: "container_t", User: "user_u"},
+			expected: []string{"user:user_u", "type:container_t"}},
+		{name: "role override", options: &runtime.SELinuxOption{Role: "user_r"},
+			expected: []string{"role:user_r"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			got, err := containerSELinuxLabelOptions(&runtime.LinuxContainerSecurityContext{
+				SelinuxOptions: test.options, Privileged: test.privileged,
+			}, podLabel)
+			require.NoError(t, err)
+			assert.Equal(t, test.expected, got)
+			if test.options != nil && test.name == "type only" {
+				assert.Empty(t, test.options.Level, "request must not be mutated")
+			}
+		})
+	}
+	context := &runtime.LinuxContainerSecurityContext{
+		SelinuxOptions: &runtime.SELinuxOption{Type: "container_logreader_t"},
+	}
+	options, err := containerSELinuxLabelOptions(context, "")
+	require.NoError(t, err)
+	assert.Equal(t, []string{"type:container_logreader_t"}, options)
+	options, err = containerSELinuxLabelOptions(context, "system_u:system_r:container_t:s0:c12,c34")
+	require.NoError(t, err)
+	assert.Contains(t, options, "level:s0:c12,c34")
+	_, err = containerSELinuxLabelOptions(context, "invalid")
+	require.Error(t, err)
+}
+
+func TestContainerMCSSharedLifetime(t *testing.T) {
+	c := newTestCRIService()
+	levels := map[string]bool{}
+	c.labels.Reserver = func(label string) {
+		context, err := selinux.NewContext(label)
+		require.NoError(t, err)
+		levels[context["level"]] = true
+	}
+	c.labels.Releaser = func(label string) {
+		context, err := selinux.NewContext(label)
+		require.NoError(t, err)
+		require.True(t, levels[context["level"]])
+		levels[context["level"]] = false
+	}
+	const podLabel = "system_u:system_r:container_t:s0:c347,c891"
+	const sidecarLabel = "system_u:system_r:container_logreader_t:s0:c347,c891"
+	require.NoError(t, c.sandboxStore.Add(sandboxstore.NewSandbox(
+		sandboxstore.Metadata{ID: "pod", ProcessLabel: podLabel}, sandboxstore.Status{})))
+	require.NoError(t, c.containerStore.Add(containerstore.Container{
+		Metadata: containerstore.Metadata{ID: "sidecar", SandboxID: "pod", ProcessLabel: sidecarLabel},
+	}))
+	require.NoError(t, c.labels.Reserve(sidecarLabel))
+	c.labels.Release(sidecarLabel)
+	assert.True(t, levels["s0:c347,c891"], "failed creation must not release the shared level")
+	c.containerStore.Delete("sidecar")
+	assert.True(t, levels["s0:c347,c891"], "sandbox still owns the level")
+	c.sandboxStore.Delete("pod")
+	assert.False(t, levels["s0:c347,c891"])
+}
