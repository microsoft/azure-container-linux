+package verity
+
+import (
+	"errors"
+	"sync"
+	"testing"
+
+	"github.com/containerd/go-dmverity/pkg/dm"
+	"golang.org/x/sys/unix"
+)
+
+type activationControl struct {
+	mu        sync.Mutex
+	exists    bool
+	loadErr   error
+	resumeErr error
+	removeErr error
+	removes   int
+}
+
+func (c *activationControl) CreateDevice(string) (uint64, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.exists {
+		return 0, unix.EBUSY
+	}
+	c.exists = true
+	return 1, nil
+}
+
+func (c *activationControl) LoadTable(string, []dm.Target) error { return c.loadErr }
+func (c *activationControl) SuspendDevice(string, bool) error    { return c.resumeErr }
+func (c *activationControl) RemoveDevice(string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.removes++
+	if c.removeErr == nil {
+		c.exists = false
+	}
+	return c.removeErr
+}
+
+func TestActivationCleanupOwnership(t *testing.T) {
+	sentinel := errors.New("activation failure")
+	for _, tc := range []struct {
+		name    string
+		control *activationControl
+		wantErr error
+		removes int
+		exists  bool
+	}{
+		{name: "duplicate", control: &activationControl{exists: true}, wantErr: unix.EBUSY, exists: true},
+		{name: "load failure", control: &activationControl{loadErr: sentinel}, wantErr: sentinel, removes: 1},
+		{name: "resume failure", control: &activationControl{resumeErr: unix.EKEYREJECTED}, wantErr: unix.EKEYREJECTED, removes: 1},
+		{name: "success", control: &activationControl{}, exists: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := tc.control
+			err := activateDevice(c, "test", dm.Target{})
+			if !errors.Is(err, tc.wantErr) || c.removes != tc.removes || c.exists != tc.exists {
+				t.Fatalf("err=%v removes=%d exists=%v", err, c.removes, c.exists)
+			}
+		})
+	}
+}
+
+func TestActivationCleanupErrorPreserved(t *testing.T) {
+	c := &activationControl{loadErr: unix.EIO, removeErr: unix.EBUSY}
+	err := activateDevice(c, "test", dm.Target{})
+	if !errors.Is(err, unix.EIO) || !errors.Is(err, unix.EBUSY) || c.removes != 1 {
+		t.Fatalf("cleanup error lost or repeated: %v removes=%d", err, c.removes)
+	}
+}
+
+func TestConcurrentActivationLoserPreservesWinner(t *testing.T) {
+	c := &activationControl{}
+	results := make(chan error, 2)
+	var wg sync.WaitGroup
+	for i := 0; i < 2; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results <- activateDevice(c, "test", dm.Target{})
+		}()
+	}
+	wg.Wait()
+	close(results)
+	successes, collisions := 0, 0
+	for err := range results {
+		switch {
+		case err == nil:
+			successes++
+		case errors.Is(err, unix.EBUSY):
+			collisions++
+		default:
+			t.Fatalf("unexpected error: %v", err)
+		}
+	}
+	if successes != 1 || collisions != 1 || !c.exists || c.removes != 0 {
+		t.Fatalf("winner lost: successes=%d collisions=%d exists=%v removes=%d", successes, collisions, c.exists, c.removes)
+	}
+}
