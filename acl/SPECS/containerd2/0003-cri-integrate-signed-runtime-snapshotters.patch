+func appendUnpackHandlerWrappers(
+	handler images.Handler,
+	store content.Store,
+	imageName string,
+	capabilities []string,
+	appendSnapshotLabels bool,
+) images.Handler {
+	if appendSnapshotLabels {
+		handler = snpkg.AppendInfoHandlerWrapper(imageName)(handler)
+	}
