+	desc.Annotations = map[string]string{snpkg.TargetLayerDmverityLabel: string(annotation)}
+
+	layerDir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(layerDir, ".erofslayer"), nil, 0644))
+	differ := erofsDiff{
