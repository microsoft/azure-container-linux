+	return &introspectionapi.PluginsResponse{Plugins: []*introspectionapi.Plugin{{
+		Type:         string(plugins.SnapshotPlugin),
+		ID:           "erofs",
+		Capabilities: []string{plugins.CapabilityDmverityReferrers},
