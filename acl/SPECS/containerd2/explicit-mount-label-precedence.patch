From b6ffb6bcb4fc2b4b94235b2d8af6b61e3fda8c93 Mon Sep 17 00:00:00 2001
From: Sean Dougherty <sdougherty@microsoft.com>
Date: Wed, 25 Nov 2026 03:53:27 +0000
Subject: [PATCH] client: let explicit mount labels replace snapshotter
 fallback contexts

An OCI workload mount label must take precedence over a snapshotter-provided fallback instead of creating duplicate SELinux context options. Preserve snapshotter defaults for clients without an explicit mount label and avoid modifying snapshotter-owned backing slices. Add regression coverage for replacement, unlabeled clients, other mount options, explicit s0, and shared slices.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 client/container.go                  | 17 +++++++-
 client/container_mount_label_test.go | 58 ++++++++++++++++++++++++++++
 2 files changed, 73 insertions(+), 2 deletions(-)
 create mode 100644 client/container_mount_label_test.go

diff --git a/client/container.go b/client/container.go
index 7974a27d6..65b351178 100644
--- a/client/container.go
+++ b/client/container.go
@@ -351,8 +351,7 @@ func (c *container) handleMounts(ctx context.Context, request *tasks.CreateTaskR
 		}
 		for _, m := range mounts {
 			if spec.Linux != nil && spec.Linux.MountLabel != "" {
-				ml := fmt.Sprintf("context=%q", spec.Linux.MountLabel)
-				m.Options = append(m.Options, ml)
+				m.Options = withMountLabel(m.Options, spec.Linux.MountLabel)
 			}
 			request.Rootfs = append(request.Rootfs, &types.Mount{
 				Type:    m.Type,
@@ -366,6 +365,20 @@ func (c *container) handleMounts(ctx context.Context, request *tasks.CreateTaskR
 	return nil
 }
 
+func withMountLabel(options []string, label string) []string {
+	if label == "" {
+		return options
+	}
+	// An explicit workload label replaces any snapshotter fallback context.
+	result := make([]string, 0, len(options)+1)
+	for _, option := range options {
+		if !strings.HasPrefix(option, "context=") {
+			result = append(result, option)
+		}
+	}
+	return append(result, fmt.Sprintf("context=%q", label))
+}
+
 func (c *container) Restore(ctx context.Context, ioCreate cio.Creator, rootDir string) (_ int, retErr error) {
 	errorPid := -1
 	i, err := ioCreate(c.id)
