+package client
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestWithMountLabel(t *testing.T) {
+	const label = "system_u:object_r:container_file_t:s0:c17,c42"
+	const option = `context="system_u:object_r:container_file_t:s0:c17,c42"`
+	const fallback = `context="system_u:object_r:container_file_t:s0"`
+	for _, tc := range []struct {
+		name     string
+		options  []string
+		label    string
+		expected []string
+	}{
+		{"unlabeled retains default", []string{"ro", fallback}, "", []string{"ro", fallback}},
+		{"unlabeled empty", nil, "", nil},
+		{"label without default", []string{"ro"}, label, []string{"ro", option}},
+		{"label replaces default", []string{"ro", fallback}, label, []string{"ro", option}},
+		{"label replaces duplicates", []string{fallback, "rw", option}, label, []string{"rw", option}},
+		{"explicit s0 replaces categories", []string{option}, "system_u:object_r:container_file_t:s0", []string{fallback}},
+		{"preserves other options", []string{"fscontext=other", "contextual=other", "rootcontext=other", "context", `lowerdir=/a\,b:/c`, fallback}, label,
+			[]string{"fscontext=other", "contextual=other", "rootcontext=other", "context", `lowerdir=/a\,b:/c`, option}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			original := slices.Clone(tc.options)
+			require.Equal(t, tc.expected, withMountLabel(tc.options, tc.label))
+			require.Equal(t, original, tc.options, "snapshotter-owned options must not be modified")
+		})
+	}
+}
+
+func TestWithMountLabelDoesNotOverwriteSharedBackingArray(t *testing.T) {
+	options := []string{"ro", "snapshotter-owned"}
+	got := withMountLabel(options[:1], "system_u:object_r:container_file_t:s0")
+	require.Equal(t, []string{"ro", `context="system_u:object_r:container_file_t:s0"`}, got)
+	require.Equal(t, "snapshotter-owned", options[1])
+}
