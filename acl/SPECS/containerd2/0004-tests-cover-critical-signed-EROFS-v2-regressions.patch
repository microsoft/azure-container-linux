+		},
+		{
+			name:           "unlabelled mount receives shared label",
+			opts:           []string{"ro", "loop"},
+			selinuxEnabled: true,
+			expected:       []string{"ro", shared},
+		},
+		{
+			name:           "SELinux disabled strips context",
+			opts:           []string{"ro", "loop", `context="system_u:object_r:container_file_t:s0:c1,c2"`},
+			selinuxEnabled: false,
+			expected:       []string{"ro"},
+		},
+		{
+			name: "internal options are stripped",
+			opts: []string{
+				"ro",
+				"loop",
+				dmverity.MountOptionModePrefix + "metadata",
+				dmverity.MountOptionRootHashPrefix + strings.Repeat("ab", 32),
+				dmverity.MountOptionSignatureDigestPrefix + digest.FromString("signature").String(),
+			},
+			expected: []string{"ro"},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := sharedLayerMountOptions(tc.opts, tc.selinuxEnabled); !slices.Equal(got, tc.expected) {
+				t.Fatalf("sharedLayerMountOptions(%q, %v) = %q, want %q", tc.opts, tc.selinuxEnabled, got, tc.expected)
+			}
+		})
+	}
+}
+
+func TestFinishDmverityMountRollsBackBeforeUnlock(t *testing.T) {
+	var events []string
+	finishDmverityMount(
+		errors.New("mount failed"),
+		"device",
+		func(string) error {
+			events = append(events, "close")
+			return nil
+		},
+		func() {
+			events = append(events, "unlock")
+		},
+	)
+
+	if !slices.Equal(events, []string{"close", "unlock"}) {
+		t.Fatalf("unexpected lifecycle order: %v", events)
+	}
+}
