+func TestSnapshotCleanupUsesPersistedSnapshotID(t *testing.T) {
+	s := &snapshotter{root: "/snapshot-root"}
+
+	committed := s.snapshotCleanup("42", snapshots.KindCommitted)
+	assert.Equal(t, s.layerBlobPath("42"), committed.layerPath)
+	assert.Equal(t, s.upperPath("42"), committed.upperPath)
+	assert.True(t, committed.releaseDmverity)
+
+	active := s.snapshotCleanup("43", snapshots.KindActive)
+	assert.Equal(t, s.layerBlobPath("43"), active.layerPath)
+	assert.Equal(t, s.upperPath("43"), active.upperPath)
+	assert.False(t, active.releaseDmverity)
