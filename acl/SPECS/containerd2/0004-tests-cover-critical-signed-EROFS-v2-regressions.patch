+func TestRequiresIndividualMountDetectsStandaloneHashDevice(t *testing.T) {
+	s := &snapshotter{root: t.TempDir()}
+	id := "1"
+	layerBlob := s.layerBlobPath(id)
+	require.NoError(t, os.MkdirAll(filepath.Dir(layerBlob), 0700))
+	require.NoError(t, os.WriteFile(dmverity.HashDevicePath(layerBlob), []byte("tree"), 0600))
+
+	required, err := s.requiresIndividualMount(id, nil)
+	require.NoError(t, err)
+	require.True(t, required)
+}
