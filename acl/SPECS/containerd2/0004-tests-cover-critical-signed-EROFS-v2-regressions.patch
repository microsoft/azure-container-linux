+)
+
+type retainedTestLabelStore struct {
+	mu     sync.Mutex
+	labels map[digest.Digest]map[string]string
+}
+
+func newRetainedTestLabelStore() *retainedTestLabelStore {
+	return &retainedTestLabelStore{labels: make(map[digest.Digest]map[string]string)}
+}
+
+func (s *retainedTestLabelStore) Get(dgst digest.Digest) (map[string]string, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.labels[dgst], nil
+}
+
+func (s *retainedTestLabelStore) Set(dgst digest.Digest, labels map[string]string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.labels[dgst] = labels
+	return nil
+}
+
+func (s *retainedTestLabelStore) Update(dgst digest.Digest, update map[string]string) (map[string]string, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	labels := s.labels[dgst]
+	if labels == nil {
+		labels = make(map[string]string)
+	}
+	for key, value := range update {
+		if value == "" {
+			delete(labels, key)
+		} else {
+			labels[key] = value
+		}
+	}
+	s.labels[dgst] = labels
+	return labels, nil
+}
+
+func TestRetainedSignatureHandlerSupportsFetchOnlyDeferredUnpack(t *testing.T) {
+	ctx := t.Context()
+	configData := []byte(`{"architecture":"amd64","os":"linux","rootfs":{"type":"layers","diff_ids":[]}}`)
+	config := selectionDescriptor(configData, ocispec.MediaTypeImageConfig)
+	layerData := []byte("source layer")
+	layer := selectionDescriptor(layerData, ocispec.MediaTypeImageLayerGzip)
+	manifestData, err := json.Marshal(ocispec.Manifest{
+		MediaType: ocispec.MediaTypeImageManifest,
+		Config:    config,
+		Layers:    []ocispec.Descriptor{layer},
+	})
+	require.NoError(t, err)
+	manifest := selectionDescriptor(manifestData, ocispec.MediaTypeImageManifest)
+	bundle := newSelectionBundle(
+		t,
+		manifest,
+		layer,
+		"retained",
+	)
+
+	fetcher := &signatureSelectionFetcher{
+		blobs: mergeSelectionBlobs(bundle.blobs, map[digest.Digest][]byte{
+			manifest.Digest: manifestData,
+			config.Digest:   configData,
+			layer.Digest:    layerData,
+		}),
+		refs: map[digest.Digest][]ocispec.Descriptor{
+			manifest.Digest: {bundle.descriptor},
+		},
+	}
+	store, err := contentlocal.NewLabeledStore(t.TempDir(), newRetainedTestLabelStore())
+	require.NoError(t, err)
+	base := images.Handlers(
+		remotes.FetchHandler(store, fetcher),
+		images.SetChildrenLabels(store, images.ChildrenHandler(store)),
+	)
+
+	children, err := AppendRetainedSignatureHandlerWrapper(fetcher, store)(base).Handle(ctx, manifest)
+	require.NoError(t, err)
+	require.Len(t, children, 2)
+	target, err := ParseDmverityTarget(children[1].Annotations[TargetLayerDmverityLabel])
+	require.NoError(t, err)
+	assert.Equal(t, bundle.rootHash, target.RootHash)
+
+	subjectInfo, err := store.Info(ctx, manifest.Digest)
+	require.NoError(t, err)
+	var retainedLabel string
+	for key, value := range subjectInfo.Labels {
+		if strings.HasPrefix(key, retainedReferrerLabelPrefix) &&
+			value == bundle.descriptor.Digest.String() {
+			retainedLabel = key
+			break
+		}
+	}
+	require.NotEmpty(t, retainedLabel)
+	for dgst := range bundle.blobs {
+		_, err := store.Info(ctx, dgst)
+		require.NoError(t, err, "retained bundle content %s is missing", dgst)
+	}
+
+	annotations, err := CachedSignatureAnnotations(ctx, store, manifest)
+	require.NoError(t, err)
+	require.Contains(t, annotations, layer.Digest)
+	target, err = ParseDmverityTarget(annotations[layer.Digest][TargetLayerDmverityLabel])
+	require.NoError(t, err)
+	assert.Equal(t, bundle.rootHash, target.RootHash)
+	assert.Equal(t, bundle.metadata.Digest, target.Metadata.Digest)
+	assert.Equal(t, bundle.tree.Digest, target.Tree.Digest)
+	assert.Len(t, annotations[layer.Digest], 1)
+
+	_, err = store.Update(ctx, content.Info{
+		Digest: manifest.Digest,
+		Labels: map[string]string{retainedLabel: ""},
+	}, "labels."+retainedLabel)
+	require.NoError(t, err)
+	annotations, err = CachedSignatureAnnotations(ctx, store, manifest)
+	require.NoError(t, err)
+	assert.Empty(t, annotations, "unmarked local referrers must not be discovered")
+}
