+)
+
+func TestApplyUsesCompactMetadataAndStandaloneTree(t *testing.T) {
+	ctx := t.Context()
+	sourceTar := []byte("uncompressed source layer")
+	sourceDesc := ocispec.Descriptor{
+		MediaType: ocispec.MediaTypeImageLayer,
+		Digest:    digest.FromBytes(sourceTar),
+		Size:      int64(len(sourceTar)),
+	}
+
+	metadata := make([]byte, 2048)
+	binary.LittleEndian.PutUint32(
+		metadata[erofsSuperOffset:erofsSuperOffset+4],
+		erofsMagic,
+	)
+	erofsUUID := uuid.NewSHA1(
+		uuid.NameSpaceURL,
+		[]byte("erofs:blobs/"+sourceDesc.Digest.String()),
+	)
+	copy(
+		metadata[erofsSuperOffset+erofsUUIDOffset:erofsSuperOffset+erofsUUIDEnd],
+		erofsUUID[:],
+	)
+	dataDevice := append(bytes.Clone(metadata), sourceTar...)
+	if remainder := len(dataDevice) % int(deviceAlignment); remainder != 0 {
+		dataDevice = append(dataDevice, make([]byte, int(deviceAlignment)-remainder)...)
+	}
+	dataDevicePath := filepath.Join(t.TempDir(), "data")
+	treePath := filepath.Join(t.TempDir(), "tree")
+	require.NoError(t, os.WriteFile(dataDevicePath, dataDevice, 0o600))
+
+	options := dmverity.DefaultDmverityOptions()
+	options.DataBlockSize = verityBlockSize
+	options.HashBlockSize = verityBlockSize
+	options.HashOffset = uint64(len(dataDevice))
+	options.UUID = "12345678-1234-1234-1234-123456789012"
+	rootHash, err := dmverity.Format(dataDevicePath, dataDevicePath, options)
+	require.NoError(t, err)
+	combined, err := os.ReadFile(dataDevicePath)
+	require.NoError(t, err)
+	tree := bytes.Clone(combined[len(dataDevice):])
+	require.NoError(t, os.WriteFile(treePath, tree, 0o600))
+	require.NoError(t, os.Truncate(dataDevicePath, int64(len(dataDevice))))
+
+	store, err := contentlocal.NewStore(t.TempDir())
+	require.NoError(t, err)
+	metadataDesc := ocispec.Descriptor{
+		MediaType: snpkg.EROFSMetadataArtifactMediaType,
+		Digest:    digest.FromBytes(metadata),
+		Size:      int64(len(metadata)),
+	}
+	treeDesc := ocispec.Descriptor{
+		MediaType: snpkg.MerkleTreeArtifactMediaType,
+		Digest:    digest.FromBytes(tree),
+		Size:      int64(len(tree)),
+	}
+	signature := []byte("pkcs7 signature")
+	signatureDesc := ocispec.Descriptor{
+		MediaType: snpkg.LayerSignatureMediaType,
+		Digest:    digest.FromBytes(signature),
+		Size:      int64(len(signature)),
+		Annotations: map[string]string{
+			"io.containerd.erofs.dmverity.source-layer-digest": sourceDesc.Digest.String(),
+			"io.containerd.erofs.dmverity.root-hash":           rootHash,
+		},
+	}
+	writeTestContent(t, store, sourceDesc, sourceTar)
+	writeTestContent(t, store, metadataDesc, metadata)
+	writeTestContent(t, store, treeDesc, tree)
+	writeTestContent(t, store, signatureDesc, signature)
+
+	targetBytes, err := json.Marshal(snpkg.DmverityTarget{
+		RootHash:  rootHash,
+		Metadata:  metadataDesc,
+		Tree:      treeDesc,
+		Signature: signatureDesc,
+	})
+	require.NoError(t, err)
+	sourceDesc.Annotations = map[string]string{
+		snpkg.TargetLayerDmverityLabel: string(targetBytes),
+	}
+
+	layerDir := t.TempDir()
+	require.NoError(t, os.WriteFile(filepath.Join(layerDir, ".erofslayer"), nil, 0o600))
+	layerPath := filepath.Join(layerDir, "layer.erofs")
+	applied, err := (erofsDiff{
+		store:                   store,
+		enableDmverityReferrers: true,
+		requireSignatures:       true,
+	}).Apply(
+		ctx,
+		sourceDesc,
+		[]mount.Mount{{Type: "bind", Source: layerPath}},
+	)
+	require.NoError(t, err)
+	require.Equal(t, digest.FromBytes(sourceTar), applied.Digest)
+	require.Equal(t, int64(len(sourceTar)), applied.Size)
+
+	actualDataDevice, err := os.ReadFile(layerPath)
+	require.NoError(t, err)
+	require.Equal(t, dataDevice, actualDataDevice)
+	actualTree, err := os.ReadFile(dmverity.HashDevicePath(layerPath))
+	require.NoError(t, err)
+	require.Equal(t, tree, actualTree)
+	actualSignature, err := os.ReadFile(dmverity.SignaturePath(layerPath))
+	require.NoError(t, err)
+	require.Equal(t, signature, actualSignature)
+	storedMetadata, err := dmverity.ReadMetadata(layerPath)
+	require.NoError(t, err)
+	require.Equal(t, rootHash, storedMetadata.RootHash)
+	require.Zero(t, storedMetadata.HashOffset)
+	require.Equal(t, filepath.Base(dmverity.HashDevicePath(layerPath)), storedMetadata.HashDevice)
+}
+
+func writeTestContent(
+	t *testing.T,
+	store content.Store,
+	desc ocispec.Descriptor,
+	data []byte,
+) {
+	t.Helper()
+	require.NoError(t, content.WriteBlob(
+		t.Context(),
+		store,
+		"test-"+desc.Digest.Encoded(),
+		bytes.NewReader(data),
+		desc,
+	))
+}
