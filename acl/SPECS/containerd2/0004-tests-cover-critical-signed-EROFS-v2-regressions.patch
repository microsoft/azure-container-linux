+func TestSignedDmverityPolicyUsesLabelsAndSignature(t *testing.T) {
+	layerBlob := createTestLayerBlob(t, t.TempDir())
+	rootHash := digest.FromString("root").Hex()
+	signature := []byte("signature")
+	require.NoError(t, dmverity.WriteMetadata(layerBlob, dmverity.DmverityMetadata{
+		RootHash:   rootHash,
+		HashOffset: 0,
+		HashDevice: filepath.Base(dmverity.HashDevicePath(layerBlob)),
+	}))
+	require.NoError(t, os.WriteFile(dmverity.HashDevicePath(layerBlob), []byte("tree"), 0644))
+	require.NoError(t, os.WriteFile(dmverity.SignaturePath(layerBlob), signature, 0644))
+
+	s := &snapshotter{enableDmverityReferrers: true}
+	option, err := s.applyDmverityPolicy(layerBlob, map[string]string{
+		snpkg.DmverityMaterializationVersionLabel:         snpkg.DmverityMaterializationVersion,
+		snpkg.DmverityMaterializationStateLabel:           snpkg.DmverityMaterializationStateSigned,
+		snpkg.DmverityMaterializationRootHashLabel:        rootHash,
+		snpkg.DmverityMaterializationSignatureDigestLabel: digest.FromBytes(signature).String(),
+	})
+	require.NoError(t, err)
+	assert.Equal(t, dmverity.MountOptionModePrefix+dmverity.MetadataPath(layerBlob), option)
+
+	require.NoError(t, os.Remove(dmverity.HashDevicePath(layerBlob)))
+	_, err = s.applyDmverityPolicy(layerBlob, map[string]string{
+		snpkg.DmverityMaterializationVersionLabel:         snpkg.DmverityMaterializationVersion,
+		snpkg.DmverityMaterializationStateLabel:           snpkg.DmverityMaterializationStateSigned,
+		snpkg.DmverityMaterializationRootHashLabel:        rootHash,
+		snpkg.DmverityMaterializationSignatureDigestLabel: digest.FromBytes(signature).String(),
+	})
+	require.ErrorContains(t, err, "hash device")
+}
