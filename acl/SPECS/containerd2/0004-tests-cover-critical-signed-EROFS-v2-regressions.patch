+
+type signatureSelectionFetcher struct {
+	blobs map[digest.Digest][]byte
+	refs  map[digest.Digest][]ocispec.Descriptor
+}
+
+func (f *signatureSelectionFetcher) Fetch(
+	_ context.Context,
+	desc ocispec.Descriptor,
+) (io.ReadCloser, error) {
+	data, ok := f.blobs[desc.Digest]
+	if !ok {
+		return nil, errors.New("blob not found")
+	}
+	return io.NopCloser(bytes.NewReader(data)), nil
+}
+
+func (f *signatureSelectionFetcher) FetchReferrers(
+	_ context.Context,
+	dgst digest.Digest,
+	_ ...remotes.FetchReferrersOpt,
+) ([]ocispec.Descriptor, error) {
+	return append([]ocispec.Descriptor(nil), f.refs[dgst]...), nil
+}
+
+func TestDmverityReferrerHandlerProvenance(t *testing.T) {
+	base := images.HandlerFunc(func(context.Context, ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+		return nil, nil
+	})
+
+	assert.False(t, HasValidatedDmverityReferrers(base))
+	assert.True(t, HasValidatedDmverityReferrers(AppendSignatureHandlerWrapper(nil)(base)))
+}
+
+func TestWithoutDmverityAnnotations(t *testing.T) {
+	annotations := map[string]string{
+		"keep":                   "value",
+		TargetLayerDmverityLabel: "target",
+	}
+
+	assert.Equal(t, map[string]string{"keep": "value"}, WithoutDmverityAnnotations(annotations))
+	assert.Len(t, annotations, 2)
+}
+
+func TestFetchSignaturesAcceptsSoleV2Referrer(t *testing.T) {
+	subject := selectionDescriptor([]byte("subject"), ocispec.MediaTypeImageManifest)
+	sourceLayer := selectionDescriptor([]byte("source layer"), ocispec.MediaTypeImageLayerGzip)
+	bundle := newSelectionBundle(t, subject, sourceLayer, "selected")
+	fetcher := &signatureSelectionFetcher{
+		blobs: bundle.blobs,
+		refs: map[digest.Digest][]ocispec.Descriptor{
+			subject.Digest: {bundle.descriptor},
+		},
+	}
+
+	selected, err := fetchSignatures(
+		t.Context(),
+		fetcher,
+		subject.Digest,
+		map[string]struct{}{sourceLayer.Digest.String(): {}},
+	)
+	require.NoError(t, err)
+	require.NotNil(t, selected)
+	assert.Equal(t, bundle.descriptor.Digest, selected.desc.Digest)
+	require.Len(t, selected.manifest.Layers, 3)
+	info := selected.layers[sourceLayer.Digest.String()]
+	require.NotNil(t, info)
+	assert.Equal(t, bundle.rootHash, info.RootHash)
+	assert.Equal(t, EROFSMetadataArtifactMediaType, info.Metadata.MediaType)
+	assert.Equal(t, MerkleTreeArtifactMediaType, info.Tree.MediaType)
+	assert.Equal(t, LayerSignatureMediaType, info.Signature.MediaType)
+}
+
+func TestFetchSignaturesRejectsMultipleV2Referrers(t *testing.T) {
+	subject := selectionDescriptor([]byte("subject"), ocispec.MediaTypeImageManifest)
+	sourceLayer := selectionDescriptor([]byte("source layer"), ocispec.MediaTypeImageLayerGzip)
+	first := newSelectionBundle(t, subject, sourceLayer, "first")
+	second := newSelectionBundle(t, subject, sourceLayer, "second")
+	fetcher := &signatureSelectionFetcher{
+		blobs: mergeSelectionBlobs(first.blobs, second.blobs),
+		refs: map[digest.Digest][]ocispec.Descriptor{
+			subject.Digest: {first.descriptor, second.descriptor},
+		},
+	}
+
+	_, err := fetchSignatures(
+		t.Context(),
+		fetcher,
+		subject.Digest,
+		map[string]struct{}{sourceLayer.Digest.String(): {}},
+	)
+	require.ErrorContains(t, err, "multiple "+SignatureArtifactType+" referrers")
+}
+
+func TestSignatureHandlerStripsUntrustedTarget(t *testing.T) {
+	subject := selectionDescriptor([]byte("subject"), ocispec.MediaTypeImageManifest)
+	layer := selectionDescriptor([]byte("layer"), ocispec.MediaTypeImageLayerGzip)
+	layer.Annotations = map[string]string{
+		TargetLayerDmverityLabel: "untrusted",
+		"example.com/keep":       "value",
+	}
+	base := images.HandlerFunc(func(
+		_ context.Context,
+		desc ocispec.Descriptor,
+	) ([]ocispec.Descriptor, error) {
+		if desc.Digest == subject.Digest {
+			return []ocispec.Descriptor{layer}, nil
+		}
+		return nil, nil
+	})
+	fetcher := &signatureSelectionFetcher{
+		blobs: map[digest.Digest][]byte{},
+		refs:  map[digest.Digest][]ocispec.Descriptor{},
+	}
+
+	children, err := AppendSignatureHandlerWrapper(fetcher)(base).Handle(t.Context(), subject)
+	require.NoError(t, err)
+	require.Len(t, children, 1)
+	assert.Equal(t, "value", children[0].Annotations["example.com/keep"])
+	assert.Empty(t, children[0].Annotations[TargetLayerDmverityLabel])
+}
+
+func TestSignatureHandlerAddsCompactTarget(t *testing.T) {
+	subject := selectionDescriptor([]byte("subject"), ocispec.MediaTypeImageManifest)
+	layer := selectionDescriptor([]byte("layer"), ocispec.MediaTypeImageLayerGzip)
+	layer.Annotations = map[string]string{
+		TargetLayerDmverityLabel: "untrusted",
+		"example.com/keep":       "value",
+	}
+	bundle := newSelectionBundle(t, subject, layer, "selected")
+	base := images.HandlerFunc(func(
+		_ context.Context,
+		desc ocispec.Descriptor,
+	) ([]ocispec.Descriptor, error) {
+		if desc.Digest == subject.Digest {
+			return []ocispec.Descriptor{layer}, nil
+		}
+		return nil, nil
+	})
+	fetcher := &signatureSelectionFetcher{
+		blobs: bundle.blobs,
+		refs: map[digest.Digest][]ocispec.Descriptor{
+			subject.Digest: {bundle.descriptor},
+		},
+	}
+
+	children, err := AppendSignatureHandlerWrapper(fetcher)(base).Handle(t.Context(), subject)
+	require.NoError(t, err)
+	require.Len(t, children, 1)
+	assert.Equal(t, "value", children[0].Annotations["example.com/keep"])
+	target, err := ParseDmverityTarget(children[0].Annotations[TargetLayerDmverityLabel])
+	require.NoError(t, err)
+	assert.Equal(t, bundle.rootHash, target.RootHash)
+	assert.Equal(t, bundle.metadata.Digest, target.Metadata.Digest)
+	assert.Equal(t, bundle.tree.Digest, target.Tree.Digest)
+	assert.Equal(t, bundle.signature.Digest, target.Signature.Digest)
+	assert.Nil(t, target.Metadata.Annotations)
+	assert.Nil(t, target.Tree.Annotations)
+	assert.Nil(t, target.Signature.Annotations)
+	assert.Empty(t, target.Metadata.URLs)
+	assert.Empty(t, target.Tree.URLs)
+	assert.Empty(t, target.Signature.URLs)
+	assert.Empty(t, target.Metadata.Data)
+	assert.Empty(t, target.Tree.Data)
+	assert.Empty(t, target.Signature.Data)
+	assert.Len(t, children[0].Annotations, 2)
+}
+
+func TestFetchSignaturesRequiresCompleteArtifact(t *testing.T) {
+	subject := selectionDescriptor([]byte("subject"), ocispec.MediaTypeImageManifest)
+	layer := selectionDescriptor([]byte("layer"), ocispec.MediaTypeImageLayerGzip)
+	bundle := newSelectionBundle(t, subject, layer, "incomplete")
+	bundle = rewriteSelectionBundle(t, bundle, func(manifest *ocispec.Manifest) {
+		manifest.Layers = manifest.Layers[1:]
+	})
+	fetcher := &signatureSelectionFetcher{
+		blobs: bundle.blobs,
+		refs: map[digest.Digest][]ocispec.Descriptor{
+			subject.Digest: {bundle.descriptor},
+		},
+	}
+
+	_, err := fetchSignatures(
+		t.Context(),
+		fetcher,
+		subject.Digest,
+		map[string]struct{}{layer.Digest.String(): {}},
+	)
+	require.ErrorContains(t, err, "incomplete precomputed artifacts")
+}
+
+func TestFetchSignaturesRejectsConflictingRootHashes(t *testing.T) {
+	subject := selectionDescriptor([]byte("subject"), ocispec.MediaTypeImageManifest)
+	layer := selectionDescriptor([]byte("layer"), ocispec.MediaTypeImageLayerGzip)
+	bundle := newSelectionBundle(t, subject, layer, "conflicting-root")
+	bundle = rewriteSelectionBundle(t, bundle, func(manifest *ocispec.Manifest) {
+		manifest.Layers[1].Annotations[layerRootHashAnnotation] = digest.FromString("different-root").Hex()
+	})
+	fetcher := &signatureSelectionFetcher{
+		blobs: bundle.blobs,
+		refs: map[digest.Digest][]ocispec.Descriptor{
+			subject.Digest: {bundle.descriptor},
+		},
+	}
+
+	_, err := fetchSignatures(
+		t.Context(),
+		fetcher,
+		subject.Digest,
+		map[string]struct{}{layer.Digest.String(): {}},
+	)
+	require.ErrorContains(t, err, "conflicting root hashes")
+}
+
+func TestParseDmverityTargetRejectsUnknownFields(t *testing.T) {
+	target, err := targetAnnotation(&DmverityTarget{
+		RootHash:  digest.FromString("root").Hex(),
+		Metadata:  selectionDescriptor(make([]byte, tarIndexAlignment), EROFSMetadataArtifactMediaType),
+		Tree:      selectionDescriptor([]byte("tree"), MerkleTreeArtifactMediaType),
+		Signature: selectionDescriptor([]byte("signature"), LayerSignatureMediaType),
+	})
+	require.NoError(t, err)
+	target = target[:len(target)-1] + `,"unexpected":true}`
+	_, err = ParseDmverityTarget(target)
+	require.ErrorContains(t, err, "unknown field")
+}
+
+type signatureSelectionBundle struct {
+	descriptor ocispec.Descriptor
+	metadata   ocispec.Descriptor
+	tree       ocispec.Descriptor
+	signature  ocispec.Descriptor
+	rootHash   string
+	blobs      map[digest.Digest][]byte
+}
+
+func newSelectionBundle(
+	t *testing.T,
+	subject ocispec.Descriptor,
+	sourceLayer ocispec.Descriptor,
+	name string,
+) signatureSelectionBundle {
+	t.Helper()
+
+	rootHash := digest.FromString("root hash " + name).Encoded()
+	metadataBytes := make([]byte, tarIndexAlignment)
+	metadata := selectionDescriptor(metadataBytes, EROFSMetadataArtifactMediaType)
+	metadata.Annotations = map[string]string{
+		sourceLayerDigestAnnotation: sourceLayer.Digest.String(),
+	}
+	treeBytes := []byte("tree-" + name)
+	tree := selectionDescriptor(treeBytes, MerkleTreeArtifactMediaType)
+	tree.Annotations = map[string]string{
+		sourceLayerDigestAnnotation: sourceLayer.Digest.String(),
+		layerRootHashAnnotation:     rootHash,
+	}
+	signatureBytes := []byte("signature-" + name)
+	signature := selectionDescriptor(signatureBytes, LayerSignatureMediaType)
+	signature.Annotations = map[string]string{
+		sourceLayerDigestAnnotation: sourceLayer.Digest.String(),
+		layerRootHashAnnotation:     rootHash,
+	}
+	configBytes := []byte("{}")
+	config := selectionDescriptor(configBytes, ocispec.MediaTypeImageConfig)
+
+	manifest := ocispec.Manifest{
+		MediaType:    ocispec.MediaTypeImageManifest,
+		ArtifactType: SignatureArtifactType,
+		Subject:      &subject,
+		Config:       config,
+		Layers:       []ocispec.Descriptor{metadata, tree, signature},
+	}
+	manifestBytes, err := json.Marshal(manifest)
+	require.NoError(t, err)
+	descriptor := selectionDescriptor(manifestBytes, ocispec.MediaTypeImageManifest)
+	descriptor.ArtifactType = SignatureArtifactType
+
+	return signatureSelectionBundle{
+		descriptor: descriptor,
+		metadata:   metadata,
+		tree:       tree,
+		signature:  signature,
+		rootHash:   rootHash,
+		blobs: map[digest.Digest][]byte{
+			descriptor.Digest: manifestBytes,
+			config.Digest:     configBytes,
+			metadata.Digest:   metadataBytes,
+			tree.Digest:       treeBytes,
+			signature.Digest:  signatureBytes,
+		},
+	}
+}
+
+func rewriteSelectionBundle(
+	t *testing.T,
+	bundle signatureSelectionBundle,
+	mutate func(*ocispec.Manifest),
+) signatureSelectionBundle {
+	t.Helper()
+
+	var manifest ocispec.Manifest
+	require.NoError(t, json.Unmarshal(bundle.blobs[bundle.descriptor.Digest], &manifest))
+	mutate(&manifest)
+	manifestBytes, err := json.Marshal(manifest)
+	require.NoError(t, err)
+	delete(bundle.blobs, bundle.descriptor.Digest)
+	bundle.descriptor = selectionDescriptor(manifestBytes, ocispec.MediaTypeImageManifest)
+	bundle.descriptor.ArtifactType = SignatureArtifactType
+	bundle.blobs[bundle.descriptor.Digest] = manifestBytes
+	return bundle
+}
+
+func mergeSelectionBlobs(maps ...map[digest.Digest][]byte) map[digest.Digest][]byte {
+	merged := make(map[digest.Digest][]byte)
+	for _, blobs := range maps {
+		for dgst, data := range blobs {
+			merged[dgst] = data
+		}
+	}
+	return merged
+}
+
+func selectionDescriptor(data []byte, mediaType string) ocispec.Descriptor {
+	return ocispec.Descriptor{
+		MediaType: mediaType,
+		Digest:    digest.FromBytes(data),
+		Size:      int64(len(data)),
+	}
+}
