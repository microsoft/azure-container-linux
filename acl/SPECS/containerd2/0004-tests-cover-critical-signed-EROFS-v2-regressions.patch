+func TestDmveritySnapshotLabelsRequireCompleteArtifact(t *testing.T) {
+	layer := func(annotations map[string]string) ocispec.Descriptor {
+		return ocispec.Descriptor{
+			Digest:      digest.FromString("layer"),
+			Annotations: annotations,
+		}
+	}
+	rootHash := digest.FromString("root").Hex()
+	target := DmverityTarget{
+		RootHash: rootHash,
+		Metadata: ocispec.Descriptor{
+			MediaType: EROFSMetadataArtifactMediaType,
+			Digest:    digest.FromString("metadata"),
+			Size:      tarIndexAlignment,
+		},
+		Tree: ocispec.Descriptor{
+			MediaType: MerkleTreeArtifactMediaType,
+			Digest:    digest.FromString("tree"),
+			Size:      1,
+		},
+		Signature: ocispec.Descriptor{
+			MediaType: LayerSignatureMediaType,
+			Digest:    digest.FromString("signature"),
+			Size:      1,
+		},
+	}
+	targetJSON, err := json.Marshal(target)
+	require.NoError(t, err)
+
+	plain, err := DmveritySnapshotLabels(layer(nil), false)
+	require.NoError(t, err)
+	assert.Equal(t, DmverityMaterializationStatePlain, plain[DmverityMaterializationStateLabel])
+
+	_, err = DmveritySnapshotLabels(layer(nil), true)
+	require.ErrorContains(t, err, "signature required")
+
+	_, err = DmveritySnapshotLabels(layer(map[string]string{
+		TargetLayerDmverityLabel: `{"referrer":"invalid"}`,
+	}), false)
+	require.ErrorContains(t, err, "invalid dm-verity target")
+
+	labels, err := DmveritySnapshotLabels(layer(map[string]string{
+		TargetLayerDmverityLabel: string(targetJSON),
+	}), true)
+	require.NoError(t, err)
+	assert.Equal(t, DmverityMaterializationStateSigned, labels[DmverityMaterializationStateLabel])
+	assert.Equal(t, rootHash, labels[DmverityMaterializationRootHashLabel])
+	assert.Equal(t, target.Signature.Digest.String(), labels[DmverityMaterializationSignatureDigestLabel])
+}
+
+func TestValidateDmveritySnapshotRejectsRotation(t *testing.T) {
+	expected := map[string]string{
+		DmverityMaterializationVersionLabel:         DmverityMaterializationVersion,
+		DmverityMaterializationStateLabel:           DmverityMaterializationStateSigned,
+		DmverityMaterializationRootHashLabel:        digest.FromString("new-root").Hex(),
+		DmverityMaterializationSignatureDigestLabel: digest.FromString("new-signature").String(),
+	}
+	existing := map[string]string{
+		DmverityMaterializationVersionLabel:         DmverityMaterializationVersion,
+		DmverityMaterializationStateLabel:           DmverityMaterializationStateSigned,
+		DmverityMaterializationRootHashLabel:        digest.FromString("old-root").Hex(),
+		DmverityMaterializationSignatureDigestLabel: digest.FromString("old-signature").String(),
+	}
+
+	require.ErrorContains(t, ValidateDmveritySnapshot(existing, expected), "does not match required root hash")
+}
