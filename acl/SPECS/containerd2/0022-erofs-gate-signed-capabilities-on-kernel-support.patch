diff --git a/internal/dmverity/dmverity_linux.go b/internal/dmverity/dmverity_linux.go
index 02877679f..f362bcdac 100644
--- a/internal/dmverity/dmverity_linux.go
+++ b/internal/dmverity/dmverity_linux.go
@@ -26,16 +26,23 @@ import (
 	"slices"
