+
+func TestRetainedDmverityDevicesStartupCleanupRunsOnce(t *testing.T) {
+	cache := newRetainedDmverityDevices(2)
+	source := "/root/snapshots/1/layer.erofs"
+	prefix := dmverity.ErofsDevicePrefix(source)
