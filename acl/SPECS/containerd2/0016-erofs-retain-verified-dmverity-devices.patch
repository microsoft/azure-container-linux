+
+func TestRetainedDmverityDevicesStartupCleanupRetriesListFailure(t *testing.T) {
+	cache := newRetainedDmverityDevices(1)
+	source := "/root/snapshots/1/layer.erofs"
+	deviceName := dmverity.ErofsDeviceName(source)
