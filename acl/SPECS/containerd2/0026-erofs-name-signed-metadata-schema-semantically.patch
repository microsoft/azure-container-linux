 pkg/snapshotters/dmverity_policy.go          |  6 +-
 pkg/snapshotters/signatures.go               | 56 ++++++++--------
 pkg/snapshotters/signatures_test.go          | 70 +++++++++++---------
 plugins/diff/erofs/differ_policy_test.go     |  6 +-
 plugins/diff/erofs/precomputed.go            | 34 +++++-----
 plugins/diff/erofs/precomputed_linux_test.go | 38 +++++------
