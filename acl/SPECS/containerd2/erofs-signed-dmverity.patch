+	normalized, err := docker.ParseDockerRef(requested)
+	if err != nil {
+		return nil, fmt.Errorf("invalid requested image reference %q: %w", requested, err)
+	}
+	selected, err := c.client.GetImage(ctx, normalized.String())
+	if err != nil {
