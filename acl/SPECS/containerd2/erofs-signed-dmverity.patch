+		}
+		return ref != "" && (strings.HasPrefix(image.ID, ref) ||
+			strings.HasPrefix(strings.TrimPrefix(image.ID, "sha256:"), ref))
+	}
+	requested := spec.GetImage()
+	if isID(requested) {
+		requested = spec.GetUserSpecifiedImage()
+	}
+	if requested == "" || isID(requested) {
