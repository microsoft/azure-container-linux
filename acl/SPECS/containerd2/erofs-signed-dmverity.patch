+	}
+
+	// Skip the kernel-generated count and search the optional arguments.
+	optionalArgs := fields[requiredParamsCount+1:]
+	for _, opt := range optionalArgs {
+		if opt == "root_hash_sig_key_desc" {
+			return true
+		}
+	}
+	return false
