+
+package erofs
+
+import "testing"
+
+func TestShareSELinuxContext(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		opt      string
+		expected string
+	}{
+		{
+			name: "quoted MCS pair is the case containerd actually emits",
+			// client.getRootFS quotes the label because the MCS pair contains a
+			// comma, which would otherwise split into a second mount option.
+			opt:      `context="system_u:object_r:container_file_t:s0:c262,c637"`,
+			expected: `context="system_u:object_r:container_file_t:s0"`,
+		},
+		{
+			name:     "unquoted label is rewritten too",
+			opt:      "context=system_u:object_r:container_file_t:s0:c262,c637",
+			expected: "context=system_u:object_r:container_file_t:s0",
+		},
+		{
+			name:     "single category",
+			opt:      `context="system_u:object_r:container_file_t:s0:c262"`,
+			expected: `context="system_u:object_r:container_file_t:s0"`,
+		},
+		{
+			name: "degenerate range collapses",
+			opt:  `context="system_u:object_r:container_file_t:s0-s0:c1.c1023"`,
+			// s0-s0 carries no more information than s0, and collapsing it keeps
+			// the value equal to what a non-range mount of the same layer asks for.
+			expected: `context="system_u:object_r:container_file_t:s0"`,
+		},
+		{
+			name:     "real range is preserved, minus categories",
+			opt:      `context="system_u:object_r:container_file_t:s0-s15:c0.c1023"`,
+			expected: `context="system_u:object_r:container_file_t:s0-s15"`,
+		},
+		{
+			name: "already category-less is returned untouched",
+			// The identity case matters: it is what makes two containers agree on
+			// the superblock label.
+			opt:      `context="system_u:object_r:container_ro_file_t:s0"`,
+			expected: `context="system_u:object_r:container_ro_file_t:s0"`,
+		},
+		{
+			name:     "label without a level is left alone",
+			opt:      "context=system_u:object_r:container_file_t",
+			expected: "context=system_u:object_r:container_file_t",
+		},
+		{
+			name:     "empty value is left alone",
+			opt:      "context=",
+			expected: "context=",
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := shareSELinuxContext(tc.opt); got != tc.expected {
+				t.Errorf("shareSELinuxContext(%q) = %q, want %q", tc.opt, got, tc.expected)
+			}
+		})
+	}
+}
+
+// TestShareSELinuxContextConverges is the property the fix actually depends on:
+// two containers with different MCS pairs must end up asking for the same
+// superblock label, or the second mount of a shared layer is rejected.
+func TestShareSELinuxContextConverges(t *testing.T) {
+	first := shareSELinuxContext(`context="system_u:object_r:container_file_t:s0:c262,c637"`)
+	second := shareSELinuxContext(`context="system_u:object_r:container_file_t:s0:c154,c335"`)
+
+	if first != second {
+		t.Errorf("labels did not converge: %q != %q", first, second)
+	}
+}
+
+func TestStripMCSCategoriesIsIdempotent(t *testing.T) {
+	const label = "system_u:object_r:container_file_t:s0:c262,c637"
+
+	once := stripMCSCategories(label)
+	if twice := stripMCSCategories(once); twice != once {
+		t.Errorf("not idempotent: %q then %q", once, twice)
+	}
+}
