+
+func TestRemoveUsesPersistedSnapshotIDForCleanup(t *testing.T) {
+	sn, err := NewSnapshotter(t.TempDir(), WithDefaultSize(1))
+	require.NoError(t, err)
+	s := sn.(*snapshotter)
+	t.Cleanup(func() { require.NoError(t, s.Close()) })
+
+	var id string
+	err = s.ms.WithTransaction(t.Context(), true, func(ctx context.Context) error {
+		snap, err := storage.CreateSnapshot(ctx, snapshots.KindActive, "active", "")
+		if err != nil {
+			return err
+		}
+		id = snap.ID
+		_, err = storage.CommitActive(ctx, "active", "committed", snapshots.Usage{})
+		return err
+	})
+	require.NoError(t, err)
+
+	require.NoError(t, os.MkdirAll(filepath.Dir(s.layerBlobPath(id)), 0755))
+	require.NoError(t, os.WriteFile(s.layerBlobPath(id), []byte("layer"), 0644))
+
+	var releasedLayer, cleanedUpper string
+	s.releaseDmverityDeviceFn = func(_ context.Context, path string) { releasedLayer = path }
+	s.cleanupUpperFn = func(path string) error { cleanedUpper = path; return nil }
+
+	require.NoError(t, s.Remove(t.Context(), "committed"))
+	assert.Equal(t, s.layerBlobPath(id), releasedLayer)
+	assert.Equal(t, s.upperPath(id), cleanedUpper)
+}
+
+func TestRemoveMissingSnapshotSkipsCleanup(t *testing.T) {
+	sn, err := NewSnapshotter(t.TempDir(), WithDefaultSize(1))
+	require.NoError(t, err)
+	s := sn.(*snapshotter)
+	t.Cleanup(func() { require.NoError(t, s.Close()) })
+
+	cleanupCalled := false
+	s.releaseDmverityDeviceFn = func(context.Context, string) { cleanupCalled = true }
+	s.cleanupUpperFn = func(string) error { cleanupCalled = true; return nil }
+
+	require.NoError(t, s.Remove(t.Context(), "missing"))
+	assert.False(t, cleanupCalled)
+}
