+)
+
+func TestHandleMountDefersDmverityToKernelMount(t *testing.T) {
+	for _, option := range []string{
+		dmverity.MountOptionModePrefix + "/tmp/layer.erofs.dmverity",
+		dmverity.MountOptionRootHashPrefix + "root-hash",
+		dmverity.MountOptionSignatureDigestPrefix + "sha256:signature",
+	} {
+		t.Run(option, func(t *testing.T) {
+			view, err := handleMount(mount.Mount{
+				Type:    "erofs",
+				Source:  filepath.Join(t.TempDir(), "missing.erofs"),
+				Options: []string{option},
+			})
+			require.Nil(t, view)
+			require.Error(t, err)
+			assert.ErrorIs(t, err, errdefs.ErrNotImplemented)
+			assert.ErrorContains(t, err, "requires kernel mount handling")
+		})
+	}
+}
+
+func TestHandleMountWithoutDmverityPreservesSourceError(t *testing.T) {
+	view, err := handleMount(mount.Mount{
+		Type:   "erofs",
+		Source: filepath.Join(t.TempDir(), "missing.erofs"),
+	})
+	require.Nil(t, view)
+	require.Error(t, err)
+	assert.ErrorIs(t, err, os.ErrNotExist)
+	assert.NotErrorIs(t, err, errdefs.ErrNotImplemented)
+}
