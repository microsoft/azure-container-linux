+func TestFetchReferrersStreamedOversizeIsFatal(t *testing.T) {
+	fetcher, subject := newFocusedReferrersFetcher(t, "streamed-oversize", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", ocispec.MediaTypeImageIndex)
+		w.WriteHeader(http.StatusOK)
+		if flusher, ok := w.(http.Flusher); ok {
+			flusher.Flush()
+		}
+		_, _ = io.WriteString(w, `{"schemaVersion":2,"manifests":[],"padding":"`)
+		_, _ = io.WriteString(w, strings.Repeat("x", int(MaxManifestSize)+1))
+		_, _ = io.WriteString(w, `"}`)
+	}))
+
+	_, err := fetcher.FetchReferrers(t.Context(), subject)
+	if err == nil {
+		t.Fatal("streamed oversized referrers index unexpectedly succeeded")
+	}
+	if errdefs.IsNotFound(err) {
+		t.Fatalf("streamed oversized referrers index was classified as absence: %v", err)
+	}
+}
+
+func TestFetchReferrersTrueAbsenceIsEmpty(t *testing.T) {
+	fetcher, subject := newFocusedReferrersFetcher(t, "true-absence", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.NotFound(w, r)
+	}))
+
+	refs, err := fetcher.FetchReferrers(t.Context(), subject)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(refs) != 0 {
+		t.Fatalf("absent referrers returned %d descriptors, want 0", len(refs))
+	}
+}
+
+func newFocusedReferrersFetcher(t *testing.T, name string, handler http.Handler) (remotes.ReferrersFetcher, digest.Digest) {
+	t.Helper()
+	subject := newContent(ocispec.MediaTypeImageManifest, []byte(`{"schemaVersion":2}`))
+	mux := http.NewServeMux()
+	mux.Handle(fmt.Sprintf("/v2/%s/manifests/%s", name, subject.Digest()), subject)
+	mux.Handle(fmt.Sprintf("/v2/%s/referrers/%s", name, subject.Digest()), handler)
+
+	base, options, closeServer := tlsServer(logHandler{t, mux})
+	t.Cleanup(closeServer)
+	image := fmt.Sprintf("%s/%s@%s", base, name, subject.Digest())
+	resolver := NewResolver(options)
+	if _, _, err := resolver.Resolve(t.Context(), image); err != nil {
+		t.Fatal(err)
+	}
+	fetcher, err := resolver.Fetcher(t.Context(), image)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return fetcher.(remotes.ReferrersFetcher), subject.Digest()
+}
