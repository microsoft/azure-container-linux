+// commitSignedIdentity returns the signed labels Commit will persist. A
+// snapshot prepared with a signed identity must be committed with the same
+// identity, so a signed preparation cannot be committed as something else.
+func commitSignedIdentity(active, committed map[string]string) (map[string]string, error) {
+	activeRootHash, activeSignature, activeSigned, err := snpkg.GetDmveritySnapshotIdentity(active)
+	if err != nil {
+		return nil, err
+	}
+	rootHash, signature, signed, err := snpkg.GetDmveritySnapshotIdentity(committed)
+	if err != nil {
