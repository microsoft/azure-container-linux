+				Applier:        testDmverityApplier{},
+			}},
+		},
+	}
+	err := ts.pull(ctx, source, testDmverityUnpackImageStore{store: is}, &transfer.Config{})
+	require.NoError(t, err)
+	require.Zero(t, fetcher.requests)
+}
