+	}
+	if activeSigned && (!signed || !strings.EqualFold(activeRootHash, rootHash) || activeSignature != signature) {
+		return nil, fmt.Errorf("commit identity differs from the prepared signed dm-verity identity")
+	}
+	if !signed {
+		return nil, nil
+	}
+	return committed, nil
