+		return children[desc.Digest], nil
+	})
+	sn := &recordingSnapshotter{committed: map[string]snapshots.Info{}}
+	applier := countingDiffIDApplier{mapping: map[digest.Digest]digest.Digest{
+		layersA[0].Descriptor.Digest: diffIDs[0],
