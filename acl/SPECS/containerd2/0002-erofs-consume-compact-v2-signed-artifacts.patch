+func imageUnpackSnapshotOpts(
+	base []snapshots.Opt,
+	imageName string,
+	manifestDigest digest.Digest,
+	layer ocispec.Descriptor,
+	capabilities []string,
+) ([]snapshots.Opt, error) {
+	snapshotLabels := map[string]string{
+		snapshotters.TargetRefLabel:            imageName,
+		snapshotters.TargetManifestDigestLabel: manifestDigest.String(),
+		snapshotters.TargetLayerDigestLabel:    layer.Digest.String(),
+	}
+	if slices.Contains(capabilities, plugins.CapabilityDmverityReferrers) {
+		materializationLabels, err := snapshotters.DmveritySnapshotLabels(
+			layer,
+			slices.Contains(capabilities, plugins.CapabilityDmveritySignaturesRequired),
+		)
+		if err != nil {
+			return nil, fmt.Errorf("validate dm-verity policy for layer %s: %w", layer.Digest, err)
+		}
+		for key, value := range materializationLabels {
+			snapshotLabels[key] = value
+		}
+	}
+
+	opts := append([]snapshots.Opt(nil), base...)
+	return append(opts, snapshots.WithLabels(snapshotLabels)), nil
+}
+
+func mergeAnnotations(base, trusted map[string]string) map[string]string {
+	merged := make(map[string]string, len(base)+len(trusted))
+	for key, value := range base {
+		merged[key] = value
+	}
+	for key, value := range trusted {
+		merged[key] = value
 	}
-	return manifest, nil
+	return merged
 }
 
