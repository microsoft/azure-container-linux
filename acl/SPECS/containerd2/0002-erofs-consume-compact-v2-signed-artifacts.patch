+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package snapshotters
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"sync"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/images"
+	"github.com/containerd/containerd/v2/core/remotes"
+	"github.com/containerd/errdefs"
+	"github.com/containerd/log"
+	"github.com/opencontainers/go-digest"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+const (
+	// TargetLayerDmverityLabel carries the compact, validated identity of the
+	// selected v2 referrer and this layer's signed root hash.
+	TargetLayerDmverityLabel = "containerd.io/dmverity/target"
+
+	sourceLayerDigestAnnotation = "io.containerd.erofs.dmverity.source-layer-digest"
+	layerRootHashAnnotation     = "io.containerd.erofs.dmverity.root-hash"
+
+	SignatureArtifactType          = "application/vnd.containerd.erofs.dmverity.v2"
+	EROFSMetadataArtifactMediaType = "application/vnd.containerd.erofs.metadata.v1"
+	MerkleTreeArtifactMediaType    = "application/vnd.containerd.erofs.dmverity.merkle-tree.v1"
+	LayerSignatureMediaType        = "application/vnd.containerd.erofs.dmverity.layer-signature.v1+pkcs7"
+
+	tarIndexAlignment = int64(512)
+
+	maxManifestSize          = 4 * 1024 * 1024
+	maxSignaturePayloadBytes = 4 * maxManifestSize
+	maxEROFSMetadataSize     = int64(1 << 30)
+	maxMerkleTreeSize        = int64(4 << 30)
+)
+
+// DmverityTarget is the only trusted transport annotation needed by the
+// snapshot policy and EROFS differ. Payload descriptors are resolved from the
+// selected referrer in the local content store.
+type DmverityTarget struct {
+	RootHash  string             `json:"rootHash"`
+	Metadata  ocispec.Descriptor `json:"metadata"`
+	Tree      ocispec.Descriptor `json:"tree"`
+	Signature ocispec.Descriptor `json:"signature"`
+}
+
+type dmverityBundle struct {
+	desc     ocispec.Descriptor
+	manifest ocispec.Manifest
+	layers   map[string]*DmverityTarget
+}
+
+// ParseDmverityTarget parses a target injected by a validated referrer handler.
+func ParseDmverityTarget(value string) (DmverityTarget, error) {
+	decoder := json.NewDecoder(bytes.NewReader([]byte(value)))
+	decoder.DisallowUnknownFields()
+	var target DmverityTarget
+	if err := decoder.Decode(&target); err != nil {
+		return DmverityTarget{}, fmt.Errorf("parse dm-verity target: %w", err)
+	}
+	if err := decoder.Decode(&struct{}{}); err != io.EOF {
+		if err == nil {
+			return DmverityTarget{}, fmt.Errorf("parse dm-verity target: unexpected trailing JSON value")
+		}
+		return DmverityTarget{}, fmt.Errorf("parse dm-verity target: %w", err)
+	}
+	if err := validateRootHash(target.RootHash); err != nil {
+		return DmverityTarget{}, err
+	}
+	if err := validateEROFSMetadataDescriptor(target.Metadata); err != nil {
+		return DmverityTarget{}, err
+	}
+	if err := validateMerkleTreeDescriptor(target.Tree); err != nil {
+		return DmverityTarget{}, err
+	}
+	if target.Signature.MediaType != LayerSignatureMediaType {
+		return DmverityTarget{}, fmt.Errorf(
+			"unexpected dm-verity signature media type %q",
+			target.Signature.MediaType,
+		)
+	}
+	if err := validateBoundedDescriptor(
+		target.Signature,
+		"signature descriptor",
+		maxManifestSize,
+	); err != nil {
+		return DmverityTarget{}, err
+	}
+	return target, nil
+}
+
+func targetAnnotation(info *DmverityTarget) (string, error) {
+	target := DmverityTarget{
+		RootHash:  info.RootHash,
+		Metadata:  compactDescriptor(info.Metadata),
+		Tree:      compactDescriptor(info.Tree),
+		Signature: compactDescriptor(info.Signature),
+	}
+	data, err := json.Marshal(target)
+	if err != nil {
+		return "", fmt.Errorf("marshal dm-verity target: %w", err)
+	}
+	return string(data), nil
+}
+
+func compactDescriptor(desc ocispec.Descriptor) ocispec.Descriptor {
+	return ocispec.Descriptor{
+		MediaType: desc.MediaType,
+		Digest:    desc.Digest,
+		Size:      desc.Size,
+	}
+}
+
+func fetchSignatures(
+	ctx context.Context,
+	fetcher remotes.Fetcher,
+	manifestDigest digest.Digest,
+	imageLayers map[string]struct{},
+) (*dmverityBundle, error) {
+	refFetcher, ok := fetcher.(remotes.ReferrersFetcher)
+	if !ok {
+		log.G(ctx).Debug("Fetcher does not support referrers API, skipping signature fetch")
+		return nil, nil
+	}
+
+	referrers, err := refFetcher.FetchReferrers(
+		ctx,
+		manifestDigest,
+		remotes.WithReferrerArtifactTypes(SignatureArtifactType),
+	)
+	if err != nil {
+		if errdefs.IsNotFound(err) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("fetch dm-verity referrers for %s: %w", manifestDigest, err)
+	}
+	switch len(referrers) {
+	case 0:
+		return nil, nil
+	case 1:
+	default:
+		return nil, fmt.Errorf(
+			"manifest %s has multiple %s referrers",
+			manifestDigest,
+			SignatureArtifactType,
+		)
+	}
+
+	refDesc := withoutExternalURLs(referrers[0])
+	if err := validateBoundedDescriptor(refDesc, "dm-verity manifest descriptor", maxManifestSize); err != nil {
+		return nil, err
+	}
+	manifestData, err := fetchDescriptor(ctx, fetcher, refDesc)
+	if err != nil {
+		return nil, fmt.Errorf("fetch dm-verity manifest %s: %w", refDesc.Digest, err)
+	}
+	var manifest ocispec.Manifest
+	if err := json.Unmarshal(manifestData, &manifest); err != nil {
+		return nil, fmt.Errorf("parse dm-verity manifest %s: %w", refDesc.Digest, err)
+	}
+	if manifest.ArtifactType != SignatureArtifactType {
+		return nil, fmt.Errorf(
+			"dm-verity manifest %s has unexpected artifact type %q",
+			refDesc.Digest,
+			manifest.ArtifactType,
+		)
+	}
+	if manifest.Subject == nil || manifest.Subject.Digest != manifestDigest {
+		return nil, fmt.Errorf(
+			"dm-verity manifest %s subject does not match image manifest %s",
+			refDesc.Digest,
+			manifestDigest,
+		)
+	}
+	manifest.Config = withoutExternalURLs(manifest.Config)
+	for i := range manifest.Layers {
+		manifest.Layers[i] = withoutExternalURLs(manifest.Layers[i])
+	}
+
+	infos, err := parsePrecomputedBundle(&manifest, imageLayers)
+	if err != nil {
+		return nil, fmt.Errorf("parse dm-verity bundle %s: %w", refDesc.Digest, err)
+	}
+	log.G(ctx).WithFields(log.Fields{
+		"bundle":   refDesc.Digest,
+		"manifest": manifestDigest,
+		"layers":   len(infos),
+	}).Info("Using signed EROFS dm-verity materialization bundle")
+	return &dmverityBundle{desc: refDesc, manifest: manifest, layers: infos}, nil
+}
+
+func parsePrecomputedBundle(
+	manifest *ocispec.Manifest,
+	imageLayers map[string]struct{},
+) (map[string]*DmverityTarget, error) {
+	if manifest.Config.Digest != "" {
+		if err := validateBoundedDescriptor(
+			manifest.Config,
+			"artifact config descriptor",
+			maxManifestSize,
+		); err != nil {
+			return nil, err
+		}
+	}
+
+	infos := make(map[string]*DmverityTarget)
+	var signaturePayloadBytes int64
+	for i := range manifest.Layers {
+		layer := manifest.Layers[i]
+		if layer.Annotations == nil {
+			return nil, fmt.Errorf("bundle layer %s has no annotations", layer.Digest)
+		}
+		sourceDigest := layer.Annotations[sourceLayerDigestAnnotation]
+		if sourceDigest == "" {
+			return nil, fmt.Errorf("bundle descriptor %s is missing its source layer digest", layer.Digest)
+		}
+		if _, err := digest.Parse(sourceDigest); err != nil {
+			return nil, fmt.Errorf("invalid source layer digest %q: %w", sourceDigest, err)
+		}
+
+		info := getLayerInfo(infos, sourceDigest)
+		switch layer.MediaType {
+		case EROFSMetadataArtifactMediaType:
+			if err := validateEROFSMetadataDescriptor(layer); err != nil {
+				return nil, err
+			}
+			if info.Metadata.Digest != "" {
+				return nil, fmt.Errorf("duplicate EROFS metadata descriptor for layer %s", sourceDigest)
+			}
+			info.Metadata = layer
+		case MerkleTreeArtifactMediaType:
+			rootHash := layer.Annotations[layerRootHashAnnotation]
+			if err := setLayerRootHash(info, rootHash); err != nil {
+				return nil, fmt.Errorf("Merkle-tree descriptor for layer %s: %w", sourceDigest, err)
+			}
+			if err := validateMerkleTreeDescriptor(layer); err != nil {
+				return nil, err
+			}
+			if info.Tree.Digest != "" {
+				return nil, fmt.Errorf("duplicate Merkle-tree descriptor for layer %s", sourceDigest)
+			}
+			info.Tree = layer
+		case LayerSignatureMediaType:
+			rootHash := layer.Annotations[layerRootHashAnnotation]
+			if err := setLayerRootHash(info, rootHash); err != nil {
+				return nil, fmt.Errorf("signature descriptor for layer %s: %w", sourceDigest, err)
+			}
+			if err := validateBoundedDescriptor(layer, "signature descriptor", maxManifestSize); err != nil {
+				return nil, err
+			}
+			if layer.Size > maxSignaturePayloadBytes-signaturePayloadBytes {
+				return nil, fmt.Errorf(
+					"aggregate signature payload size exceeds maximum %d",
+					maxSignaturePayloadBytes,
+				)
+			}
+			signaturePayloadBytes += layer.Size
+			if len(layer.Data) > 0 {
+				if err := verifyDescriptorPayload(layer, layer.Data); err != nil {
+					return nil, fmt.Errorf(
+						"validate embedded signature descriptor for layer %s: %w",
+						sourceDigest,
+						err,
+					)
+				}
+			}
+			if info.Signature.Digest != "" {
+				return nil, fmt.Errorf("duplicate signature descriptor for layer %s", sourceDigest)
+			}
+			info.Signature = layer
+		default:
+			return nil, fmt.Errorf("unexpected bundle layer media type %q", layer.MediaType)
+		}
+	}
+
+	for sourceDigest, info := range infos {
+		if info.Metadata.Digest == "" ||
+			info.Tree.Digest == "" ||
+			info.Signature.Digest == "" ||
+			info.RootHash == "" {
+			return nil, fmt.Errorf("incomplete precomputed artifacts for layer %s", sourceDigest)
+		}
+	}
+	if len(infos) == 0 {
+		return nil, fmt.Errorf("precomputed bundle contains no layer artifacts")
+	}
+	if imageLayers != nil {
+		for sourceDigest := range imageLayers {
+			if _, ok := infos[sourceDigest]; !ok {
+				return nil, fmt.Errorf("precomputed bundle does not contain source layer %s", sourceDigest)
+			}
+		}
+		for sourceDigest := range infos {
+			if _, ok := imageLayers[sourceDigest]; !ok {
+				return nil, fmt.Errorf("precomputed bundle contains unknown source layer %s", sourceDigest)
+			}
+		}
+	}
+	return infos, nil
+}
+
+func validateEROFSMetadataDescriptor(desc ocispec.Descriptor) error {
+	if desc.MediaType != EROFSMetadataArtifactMediaType {
+		return fmt.Errorf("unexpected EROFS metadata media type %q", desc.MediaType)
+	}
+	if err := validateBoundedDescriptor(
+		desc,
+		"EROFS metadata descriptor",
+		maxEROFSMetadataSize,
+	); err != nil {
+		return err
+	}
+	if desc.Size%tarIndexAlignment != 0 {
+		return fmt.Errorf(
+			"EROFS metadata descriptor %s has unaligned size %d",
+			desc.Digest,
+			desc.Size,
+		)
+	}
+	return nil
+}
+
+func validateMerkleTreeDescriptor(desc ocispec.Descriptor) error {
+	if desc.MediaType != MerkleTreeArtifactMediaType {
+		return fmt.Errorf("unexpected Merkle-tree media type %q", desc.MediaType)
+	}
+	return validateBoundedDescriptor(desc, "Merkle-tree descriptor", maxMerkleTreeSize)
+}
+
+func setLayerRootHash(info *DmverityTarget, rootHash string) error {
+	if err := validateRootHash(rootHash); err != nil {
+		return err
+	}
+	if info.RootHash != "" && info.RootHash != rootHash {
+		return fmt.Errorf("conflicting root hashes %q and %q", info.RootHash, rootHash)
+	}
+	info.RootHash = rootHash
+	return nil
+}
+
+func validateRootHash(rootHash string) error {
+	rootDigest, err := hex.DecodeString(rootHash)
+	if err != nil || len(rootDigest) != sha256.Size || rootHash != string(bytes.ToLower([]byte(rootHash))) {
+		return fmt.Errorf("invalid SHA-256 dm-verity root hash %q", rootHash)
+	}
+	return nil
+}
+
+func validateBoundedDescriptor(desc ocispec.Descriptor, label string, maxSize int64) error {
+	if err := desc.Digest.Validate(); err != nil {
+		return fmt.Errorf("%s has invalid digest %q: %w", label, desc.Digest, err)
+	}
+	if desc.Size <= 0 {
+		return fmt.Errorf("%s %s has invalid size %d", label, desc.Digest, desc.Size)
+	}
+	if desc.Size > maxSize {
+		return fmt.Errorf("%s %s size %d exceeds maximum %d", label, desc.Digest, desc.Size, maxSize)
+	}
+	return nil
+}
+
+func withoutExternalURLs(desc ocispec.Descriptor) ocispec.Descriptor {
+	desc.URLs = nil
+	return desc
+}
+
+func getLayerInfo(
+	infos map[string]*DmverityTarget,
+	sourceDigest string,
+) *DmverityTarget {
+	info := infos[sourceDigest]
+	if info == nil {
+		info = &DmverityTarget{}
+		infos[sourceDigest] = info
+	}
+	return info
+}
+
+func fetchDescriptor(
+	ctx context.Context,
+	fetcher remotes.Fetcher,
+	desc ocispec.Descriptor,
+) ([]byte, error) {
+	if err := validateBoundedDescriptor(desc, "descriptor", maxManifestSize); err != nil {
+		return nil, err
+	}
+	rc, err := fetcher.Fetch(ctx, desc)
+	if err != nil {
+		return nil, err
+	}
+	defer rc.Close()
+
+	verifier := desc.Digest.Verifier()
+	data, err := io.ReadAll(io.TeeReader(io.LimitReader(rc, desc.Size+1), verifier))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(data)) != desc.Size {
+		return nil, fmt.Errorf(
+			"descriptor %s size mismatch: got %d, expected %d",
+			desc.Digest,
+			len(data),
+			desc.Size,
+		)
+	}
+	if !verifier.Verified() {
+		return nil, fmt.Errorf("descriptor %s digest verification failed", desc.Digest)
+	}
+	return data, nil
+}
+
+func verifyDescriptorPayload(desc ocispec.Descriptor, payload []byte) error {
+	if err := desc.Digest.Validate(); err != nil {
+		return fmt.Errorf("invalid descriptor digest %q: %w", desc.Digest, err)
+	}
+	if int64(len(payload)) != desc.Size {
+		return fmt.Errorf(
+			"descriptor %s size mismatch: got %d, expected %d",
+			desc.Digest,
+			len(payload),
+			desc.Size,
+		)
+	}
+	verifier := desc.Digest.Verifier()
+	if _, err := verifier.Write(payload); err != nil {
+		return fmt.Errorf("hash descriptor %s payload: %w", desc.Digest, err)
+	}
+	if !verifier.Verified() {
+		return fmt.Errorf("descriptor %s digest verification failed", desc.Digest)
+	}
+	return nil
+}
+
+// AppendSignatureHandlerWrapper creates a handler that fetches and validates
+// the sole v2 dm-verity referrer for an image manifest.
+func AppendSignatureHandlerWrapper(fetcher remotes.Fetcher) func(images.Handler) images.Handler {
+	return func(handler images.Handler) images.Handler {
+		return &signatureHandlerWrapper{handler: handler, fetcher: fetcher}
+	}
+}
+
+// AppendRetainedSignatureHandlerWrapper validates registry referrers and
+// persists the selected standard OCI referrer graph for deferred unpack.
+func AppendRetainedSignatureHandlerWrapper(
+	fetcher remotes.Fetcher,
+	store content.Store,
+) func(images.Handler) images.Handler {
+	return func(handler images.Handler) images.Handler {
+		return &signatureHandlerWrapper{handler: handler, fetcher: fetcher, store: store}
+	}
+}
+
+// AppendSignatureHandlerWrapperFromResolver lazily creates a fetcher from a resolver.
+func AppendSignatureHandlerWrapperFromResolver(
+	resolver remotes.Resolver,
+	ref string,
+) func(images.Handler) images.Handler {
+	return func(handler images.Handler) images.Handler {
+		return &resolverSignatureHandlerWrapper{
+			handler:  handler,
+			resolver: resolver,
+			ref:      ref,
+		}
+	}
+}
+
+type validatedDmverityReferrerHandler interface {
+	images.Handler
+	validatedDmverityReferrers()
+}
+
+type signatureHandlerWrapper struct {
+	handler images.Handler
+	fetcher remotes.Fetcher
+	store   content.Store
+}
+
+func (*signatureHandlerWrapper) validatedDmverityReferrers() {}
+
+func (h *signatureHandlerWrapper) Handle(
+	ctx context.Context,
+	desc ocispec.Descriptor,
+) ([]ocispec.Descriptor, error) {
+	return handleSignatures(ctx, h.handler, h.fetcher, h.store, desc)
+}
+
+type resolverSignatureHandlerWrapper struct {
+	handler  images.Handler
+	resolver remotes.Resolver
+	ref      string
+
+	fetcherOnce sync.Once
+	fetcher     remotes.Fetcher
+	fetcherErr  error
+}
+
+func (*resolverSignatureHandlerWrapper) validatedDmverityReferrers() {}
+
+func (h *resolverSignatureHandlerWrapper) Handle(
+	ctx context.Context,
+	desc ocispec.Descriptor,
+) ([]ocispec.Descriptor, error) {
+	h.fetcherOnce.Do(func() {
+		h.fetcher, h.fetcherErr = h.resolver.Fetcher(ctx, h.ref)
+	})
+	if h.fetcherErr != nil {
+		return nil, fmt.Errorf("create fetcher for dm-verity artifact lookup: %w", h.fetcherErr)
+	}
+	return handleSignatures(ctx, h.handler, h.fetcher, nil, desc)
+}
+
+// HasValidatedDmverityReferrers reports whether a handler validates and injects
+// dm-verity targets from OCI referrers.
+func HasValidatedDmverityReferrers(handler images.Handler) bool {
+	_, ok := handler.(validatedDmverityReferrerHandler)
+	return ok
+}
+
+func AppendCachedSignatureHandlerWrapper(store content.Store) func(images.Handler) images.Handler {
+	return func(handler images.Handler) images.Handler {
+		return &cachedSignatureHandlerWrapper{
+			handler: handler,
+			store:   store,
+		}
+	}
+}
+
+type cachedSignatureHandlerWrapper struct {
+	handler images.Handler
+	store   content.Store
+}
+
+func (*cachedSignatureHandlerWrapper) validatedDmverityReferrers() {}
+
+func (h *cachedSignatureHandlerWrapper) Handle(
+	ctx context.Context,
+	desc ocispec.Descriptor,
+) ([]ocispec.Descriptor, error) {
+	children, err := h.handler.Handle(ctx, desc)
+	if err != nil || !images.IsManifestType(desc.MediaType) {
+		return children, err
+	}
+	imageLayers := dmverityImageLayers(children)
+	infos, err := loadRetainedDmverityBundle(ctx, h.store, desc.Digest, imageLayers)
+	if err != nil || infos == nil {
+		return children, err
+	}
+	return annotateDmverityTargets(children, infos)
+}
+
+func CachedSignatureAnnotations(
+	ctx context.Context,
+	store content.Store,
+	manifest ocispec.Descriptor,
+) (map[digest.Digest]map[string]string, error) {
+	children, err := AppendCachedSignatureHandlerWrapper(store)(
+		images.ChildrenHandler(store),
+	).Handle(ctx, manifest)
+	if err != nil {
+		return nil, fmt.Errorf("resolve cached dm-verity annotations: %w", err)
+	}
+
+	annotations := make(map[digest.Digest]map[string]string)
+	for _, child := range children {
+		target := child.Annotations[TargetLayerDmverityLabel]
+		if !images.IsLayerType(child.MediaType) || target == "" {
+			continue
+		}
+		annotations[child.Digest] = map[string]string{TargetLayerDmverityLabel: target}
+	}
+	return annotations, nil
+}
+
+func handleSignatures(
+	ctx context.Context,
+	handler images.Handler,
+	fetcher remotes.Fetcher,
+	store content.Store,
+	desc ocispec.Descriptor,
+) ([]ocispec.Descriptor, error) {
+	children, err := handler.Handle(ctx, desc)
+	if err != nil {
+		return nil, err
+	}
+	if !images.IsManifestType(desc.MediaType) {
+		return children, nil
+	}
+
+	imageLayers := dmverityImageLayers(children)
+
+	selected, err := fetchSignatures(ctx, fetcher, desc.Digest, imageLayers)
+	if err != nil {
+		return nil, err
+	}
+	if selected == nil {
+		return children, nil
+	}
+
+	if store != nil {
+		if err := persistSignatureReferrer(ctx, handler, store, desc, selected); err != nil {
+			return nil, err
+		}
+	} else {
+		if _, err := handler.Handle(ctx, selected.desc); err != nil {
+			return nil, fmt.Errorf("fetch dm-verity referrer manifest %s: %w", selected.desc.Digest, err)
+		}
+		if selected.manifest.Config.Digest != "" {
+			if _, err := handler.Handle(ctx, selected.manifest.Config); err != nil {
+				return nil, fmt.Errorf(
+					"fetch dm-verity referrer config %s: %w",
+					selected.manifest.Config.Digest,
+					err,
+				)
+			}
+		}
+		for _, artifact := range selected.manifest.Layers {
+			if _, err := handler.Handle(ctx, artifact); err != nil {
+				return nil, fmt.Errorf("fetch dm-verity artifact %s: %w", artifact.Digest, err)
+			}
+		}
+	}
+
+	return annotateDmverityTargets(children, selected.layers)
+}
+
+func dmverityImageLayers(children []ocispec.Descriptor) map[string]struct{} {
+	imageLayers := make(map[string]struct{})
+	for i := range children {
+		if images.IsLayerType(children[i].MediaType) {
+			children[i].Annotations = WithoutDmverityAnnotations(children[i].Annotations)
+			imageLayers[children[i].Digest.String()] = struct{}{}
+		}
+	}
+	return imageLayers
+}
+
+func annotateDmverityTargets(
+	children []ocispec.Descriptor,
+	infos map[string]*DmverityTarget,
+) ([]ocispec.Descriptor, error) {
+	for i := range children {
+		child := &children[i]
+		if !images.IsLayerType(child.MediaType) {
+			continue
+		}
+		info := infos[child.Digest.String()]
+		if info == nil {
+			return nil, fmt.Errorf("verified dm-verity bundle does not contain layer %s", child.Digest)
+		}
+		target, err := targetAnnotation(info)
+		if err != nil {
+			return nil, err
+		}
+		if child.Annotations == nil {
+			child.Annotations = make(map[string]string)
+		}
+		child.Annotations[TargetLayerDmverityLabel] = target
+	}
+	return children, nil
+}
+
+func persistSignatureReferrer(
+	ctx context.Context,
+	handler images.Handler,
+	store content.Store,
+	subject ocispec.Descriptor,
+	referrer *dmverityBundle,
+) error {
+	if _, err := handler.Handle(ctx, referrer.desc); err != nil {
+		return fmt.Errorf("fetch dm-verity referrer manifest %s: %w", referrer.desc.Digest, err)
+	}
+
+	children := append([]ocispec.Descriptor(nil), referrer.manifest.Layers...)
+	if referrer.manifest.Config.Digest != "" {
+		children = append([]ocispec.Descriptor{referrer.manifest.Config}, children...)
+	}
+	for _, child := range children {
+		if _, err := handler.Handle(ctx, child); err != nil {
+			return fmt.Errorf("fetch dm-verity referrer content %s: %w", child.Digest, err)
+		}
+	}
+
+	labelChildren := images.SetChildrenLabels(store, images.HandlerFunc(
+		func(context.Context, ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+			return children, nil
+		},
+	))
+	if _, err := labelChildren.Handle(ctx, referrer.desc); err != nil {
+		return fmt.Errorf("retain dm-verity referrer children for %s: %w", referrer.desc.Digest, err)
+	}
+
+	referrerChild := referrer.desc
+	referrerChild.Annotations = map[string]string{
+		images.AnnotationManifestSubject: subject.Digest.String(),
+	}
+	labelReferrer := images.SetChildrenLabels(store, images.HandlerFunc(
+		func(context.Context, ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+			return []ocispec.Descriptor{referrerChild}, nil
+		},
+	))
+	if _, err := labelReferrer.Handle(ctx, subject); err != nil {
+		return fmt.Errorf(
+			"retain dm-verity referrer %s for image manifest %s: %w",
+			referrer.desc.Digest,
+			subject.Digest,
+			err,
+		)
+	}
+	return nil
+}
+
+// WithoutDmverityAnnotations removes the target annotation that is trusted
+// only when injected by a validated OCI referrer handler.
+func WithoutDmverityAnnotations(annotations map[string]string) map[string]string {
+	if len(annotations) == 0 {
+		return nil
+	}
+	sanitized := make(map[string]string, len(annotations))
+	for key, value := range annotations {
+		if key != TargetLayerDmverityLabel {
+			sanitized[key] = value
+		}
+	}
+	if len(sanitized) == 0 {
+		return nil
+	}
+	return sanitized
+}
