+   limitations under the License.
+*/
+
+package snapshotters
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/images"
+	"github.com/containerd/errdefs"
+	"github.com/opencontainers/go-digest"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+const retainedReferrerLabelPrefix = "containerd.io/gc.ref.content.referrer.sha256."
+
+func loadRetainedDmverityBundle(
+	ctx context.Context,
+	store content.Store,
+	subject digest.Digest,
+	imageLayers map[string]struct{},
+) (map[string]*DmverityTarget, error) {
+	referrers, err := retainedDmverityReferrers(ctx, store, subject)
+	if err != nil {
+		return nil, err
+	}
+	switch len(referrers) {
+	case 0:
+		return nil, nil
+	case 1:
+	default:
+		return nil, fmt.Errorf("manifest %s has multiple retained %s referrers", subject, SignatureArtifactType)
+	}
+
+	data, err := content.ReadBlob(ctx, store, referrers[0])
+	if err != nil {
+		return nil, fmt.Errorf("read retained dm-verity referrer %s: %w", referrers[0].Digest, err)
+	}
+	if err := verifyDescriptorPayload(referrers[0], data); err != nil {
+		return nil, err
+	}
+	var manifest ocispec.Manifest
+	if err := json.Unmarshal(data, &manifest); err != nil {
+		return nil, fmt.Errorf("parse retained dm-verity referrer %s: %w", referrers[0].Digest, err)
+	}
+	if manifest.ArtifactType != SignatureArtifactType ||
+		manifest.Subject == nil ||
+		manifest.Subject.Digest != subject {
+		return nil, fmt.Errorf("retained content %s is not a valid dm-verity referrer", referrers[0].Digest)
+	}
+	for i := range manifest.Layers {
+		manifest.Layers[i] = withoutExternalURLs(manifest.Layers[i])
+	}
+	infos, err := parsePrecomputedBundle(&manifest, imageLayers)
+	return infos, err
+}
+
+func retainedDmverityReferrers(
+	ctx context.Context,
+	store content.Store,
+	subject digest.Digest,
+) ([]ocispec.Descriptor, error) {
+	subjectInfo, err := store.Info(ctx, subject)
+	if err != nil {
+		if errdefs.IsNotFound(err) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("inspect retained dm-verity subject %s: %w", subject, err)
+	}
+	values := make(map[string]struct{})
+	for key, value := range subjectInfo.Labels {
+		if strings.HasPrefix(key, retainedReferrerLabelPrefix) && value != "" {
+			values[value] = struct{}{}
+		}
+	}
+	ordered := make([]string, 0, len(values))
+	for value := range values {
+		ordered = append(ordered, value)
+	}
+	sort.Strings(ordered)
+
+	var referrers []ocispec.Descriptor
+	for _, value := range ordered {
+		referrerDigest, err := digest.Parse(value)
+		if err != nil {
+			return nil, fmt.Errorf("invalid retained referrer on %s: %w", subject, err)
+		}
+		info, err := store.Info(ctx, referrerDigest)
+		if err != nil {
+			return nil, fmt.Errorf("inspect retained referrer %s: %w", referrerDigest, err)
+		}
+		desc := ocispec.Descriptor{
+			MediaType: ocispec.MediaTypeImageManifest,
+			Digest:    referrerDigest,
+			Size:      info.Size,
+		}
+		if err := validateBoundedDescriptor(desc, "retained referrer", maxManifestSize); err != nil {
+			return nil, err
+		}
+		data, err := content.ReadBlob(ctx, store, desc)
+		if err != nil {
+			return nil, fmt.Errorf("read retained referrer %s: %w", referrerDigest, err)
+		}
+		var manifest ocispec.Manifest
+		if err := json.Unmarshal(data, &manifest); err != nil {
+			return nil, fmt.Errorf("parse retained referrer %s: %w", referrerDigest, err)
+		}
+		if manifest.ArtifactType != SignatureArtifactType {
+			continue
+		}
+		if !images.IsManifestType(manifest.MediaType) ||
+			manifest.Subject == nil ||
+			manifest.Subject.Digest != subject {
+			return nil, fmt.Errorf("retained dm-verity referrer %s does not target subject %s", referrerDigest, subject)
+		}
+		desc.MediaType = manifest.MediaType
+		desc.ArtifactType = manifest.ArtifactType
+		referrers = append(referrers, desc)
+	}
+	return referrers, nil
+}
diff --git a/pkg/snapshotters/signatures.go b/pkg/snapshotters/signatures.go
