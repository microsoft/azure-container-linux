+++ b/plugins/mount/erofs/plugin_linux.go
@@ -118,9 +118,9 @@ func (h *erofsMountHandler) Mount(ctx context.Context, m mount.Mount, mp string,
 
 		var devicePath, cleanupName string
 		if signedDmverity {
-			devicePath, cleanupName, err = setupSignedDmVerityDevice(ctx, m.Source, expectedRootHash, metadata.HashOffset, expectedSignatureDigest)
+			devicePath, cleanupName, err = setupSignedDmVerityDevice(ctx, m.Source, expectedRootHash, metadata.HashOffset, expectedSignatureDigest, m.Options)
 		} else {
-			devicePath, cleanupName, err = setupDmVerityDevice(ctx, m.Source, metadata)
+			devicePath, cleanupName, err = setupDmVerityDevice(ctx, m.Source, metadata, m.Options)
 		}
 		dmverityDevice = cleanupName
 		if err != nil {
@@ -203,7 +203,7 @@ func (h *erofsMountHandler) Mount(ctx context.Context, m mount.Mount, mp string,
 // setupDmVerityDevice creates or reuses a dm-verity device for the given EROFS source.
 // It returns the device path to mount from, and a cleanup name (non-empty only when
 // a new device was created, so the caller can close it on error).
-func setupDmVerityDevice(ctx context.Context, source string, metadata *dmverity.DmverityMetadata) (devicePath string, cleanupName string, err error) {
+func setupDmVerityDevice(ctx context.Context, source string, metadata *dmverity.DmverityMetadata, mountOptions []string) (devicePath string, cleanupName string, err error) {
 	supported, err := dmverity.IsSupported()
 	if err != nil || !supported {
 		return "", "", fmt.Errorf("layer requires dm-verity but system doesn't support it (dm_verity module not loaded): %w", err)
@@ -212,7 +212,7 @@ func setupDmVerityDevice(ctx context.Context, source string, metadata *dmverity.
 	// Extract snapshot ID from source path
 	// Path format: {root}/snapshots/{id}/layer.erofs
 	snapshotID := filepath.Base(filepath.Dir(source))
-	deviceName := fmt.Sprintf("containerd-erofs-%s", snapshotID)
+	deviceName := dmverityDeviceNameForMount(fmt.Sprintf("containerd-erofs-%s", snapshotID), mountOptions)
 	devicePath = dmverity.DevicePath(deviceName)
 
 	log.G(ctx).WithFields(log.Fields{
@@ -246,8 +246,8 @@ func setupDmVerityDevice(ctx context.Context, source string, metadata *dmverity.
 	return devicePath, "", nil
 }
 
-// setupSignedDmVerityDevice creates or reuses one signed mapper for a layer.
-func setupSignedDmVerityDevice(ctx context.Context, source, expectedRootHash string, hashOffset uint64, expectedSignatureDigest string) (devicePath string, cleanupName string, err error) {
+// setupSignedDmVerityDevice creates or reuses a signed mapper for a layer and mount context.
+func setupSignedDmVerityDevice(ctx context.Context, source, expectedRootHash string, hashOffset uint64, expectedSignatureDigest string, mountOptions []string) (devicePath string, cleanupName string, err error) {
 	supported, err := dmverity.IsSupported()
 	if err != nil || !supported {
 		return "", "", fmt.Errorf("layer requires dm-verity but system doesn't support it (dm_verity module not loaded): %w", err)
@@ -255,7 +255,7 @@ func setupSignedDmVerityDevice(ctx context.Context, source, expectedRootHash str
 
 	snapshotID := filepath.Base(filepath.Dir(filepath.Clean(source)))
 	verityIdentity := digest.FromString(expectedRootHash + "-" + expectedSignatureDigest).Encoded()[:32]
-	deviceName := signedDmverityDeviceNamePrefix + snapshotID + "-" + verityIdentity
+	deviceName := dmverityDeviceNameForMount(signedDmverityDeviceNamePrefix+snapshotID+"-"+verityIdentity, mountOptions)
 	devicePath = dmverity.DevicePath(deviceName)
 	signatureFile, err := dmveritySignatureFile(source)
 	if err != nil {
@@ -282,6 +282,26 @@ func setupSignedDmVerityDevice(ctx context.Context, source, expectedRootHash str
 	return devicePath, "", nil
 }
 
+func dmverityDeviceNameForMount(base string, options []string) string {
+	var securityOptions []string
+	for _, option := range options {
+		key, _, hasValue := strings.Cut(option, "=")
+		if !hasValue {
+			continue
+		}
+		switch key {
+		case "context", "fscontext", "defcontext", "rootcontext":
+			securityOptions = append(securityOptions, option)
+		}
+	}
+	if len(securityOptions) == 0 {
+		return base
+	}
+	// SELinux mount labels apply to the superblock, so different labels must not
+	// reuse one filesystem device. Keep the existing identity for unlabeled mounts.
+	return base + "-" + digest.FromString(strings.Join(securityOptions, "\x00")).Encoded()[:32]
+}
+
 // dmveritySignatureFile checks readability and nonempty contents before mapper reuse.
 func dmveritySignatureFile(source string) (string, error) {
 	signatureFile := dmverity.SignaturePath(source)
