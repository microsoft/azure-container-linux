+func TestDmverityDeviceNameForMount(t *testing.T) {
+	for _, base := range []string{
+		"containerd-erofs-123",
+		signedDmverityDeviceNamePrefix + "123-" + strings.Repeat("a", 32),
+	} {
+		t.Run(base, func(t *testing.T) {
+			require.Equal(t, base, dmverityDeviceNameForMount(base, nil))
+			require.Equal(t, base, dmverityDeviceNameForMount(base, []string{"ro", "loop", "contextual=unrelated"}))
+			seen := map[string]bool{base: true}
+			for _, key := range []string{"context", "fscontext", "defcontext", "rootcontext"} {
+				for _, value := range []string{
+					`"system_u:object_r:container_file_t:s0:c1,c2"`,
+					`"system_u:object_r:container_file_t:s0:c3,c4"`,
+				} {
+					options := []string{key + "=" + value}
+					name := dmverityDeviceNameForMount(base, options)
+					require.False(t, seen[name], "different security options share %q", name)
+					seen[name] = true
+					require.True(t, strings.HasPrefix(name, base+"-"))
+					require.Len(t, name, len(base)+33)
+					require.Equal(t, name, dmverityDeviceNameForMount(base, append([]string{"ro"}, options...)))
+					require.Equal(t, name, dmverityDeviceNameForMount(base, options))
+				}
+			}
+		})
+	}
+}
+
+func TestDmveritySELinuxMountIsolation(t *testing.T) {
+	testutil.RequiresRoot(t)
+	if !selinux.GetEnabled() {
+		t.Skip("SELinux is not enabled")
+	}
+	if _, err := exec.LookPath("mkfs.erofs"); err != nil {
+		t.Skipf("mkfs.erofs is unavailable: %v", err)
+	}
+	supported, err := dmverity.IsSupported()
+	require.NoError(t, err)
+	require.True(t, supported)
+
+	directory, err := os.MkdirTemp(t.TempDir(), "snapshot-")
+	require.NoError(t, err)
+	source := filepath.Join(directory, "root")
+	require.NoError(t, os.Mkdir(source, 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(source, "payload"), []byte("shared layer\n"), 0644))
+	layer := filepath.Join(directory, "layer.erofs")
+	output, err := exec.Command("mkfs.erofs", layer, source).CombinedOutput()
+	require.NoError(t, err, "%s", output)
+	info, err := os.Stat(layer)
+	require.NoError(t, err)
+	// Use multiple data blocks so the fixture has a nonempty verity hash tree.
+	offset := (info.Size() + 4095) &^ 4095
+	if offset < 1024*1024 {
+		offset = 1024 * 1024
+	}
+	require.NoError(t, os.Truncate(layer, offset))
+	options := dmverity.DefaultDmverityOptions()
+	options.UUID = "12345678-1234-1234-1234-123456789012"
+	options.DataBlocks = uint64(offset / 4096)
+	options.HashOffset = uint64(offset)
+	rootHash, err := dmverity.Format(layer, layer, options)
+	require.NoError(t, err)
+	metadata, err := json.Marshal(dmverity.DmverityMetadata{
+		RootHash: rootHash, HashOffset: uint64(offset),
+	})
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(dmverity.MetadataPath(layer), metadata, 0600))
+
+	processA, labelA := selinux.ContainerLabels()
+	processB, labelB := selinux.ContainerLabels()
+	t.Cleanup(func() {
+		selinux.ReleaseLabel(processA)
+		selinux.ReleaseLabel(processB)
+	})
+	require.NotEmpty(t, labelA)
+	require.NotEmpty(t, labelB)
+	require.NotEqual(t, labelA, labelB)
+
+	handler := NewErofsMountHandler()
+	contexts := []string{"", labelA, labelB}
+	devices := make(map[string]string)
+	for _, mountLabel := range contexts {
+		target := t.TempDir()
+		options := []string{"ro", "loop", dmverity.MountOptionMetadataPrefix + dmverity.MetadataPath(layer)}
+		if mountLabel != "" {
+			options = append(options, label.FormatMountLabel("", mountLabel))
+		}
+		active, err := handler.Mount(context.Background(), mount.Mount{
+			Type: "erofs", Source: layer, Options: options,
+		}, target, nil)
+		require.NoError(t, err, "mount label %q", mountLabel)
+		t.Cleanup(func() {
+			require.NoError(t, handler.Unmount(context.Background(), target))
+		})
+		for priorLabel, device := range devices {
+			require.NotEqual(t, device, active.Mount.Source,
+				"labels %q and %q must not share a filesystem device", priorLabel, mountLabel)
+		}
+		devices[mountLabel] = active.Mount.Source
+		payload, err := os.ReadFile(filepath.Join(target, "payload"))
+		require.NoError(t, err)
+		require.Equal(t, "shared layer\n", string(payload))
+		if mountLabel != "" {
+			actual, err := selinux.FileLabel(filepath.Join(target, "payload"))
+			require.NoError(t, err)
+			require.Equal(t, mountLabel, actual)
+		}
+	}
+}
