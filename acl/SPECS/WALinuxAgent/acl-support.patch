diff --git a/azurelinuxagent/common/future.py b/azurelinuxagent/common/future.py
index be28ba9..09622fe 100644
--- a/azurelinuxagent/common/future.py
+++ b/azurelinuxagent/common/future.py
@@ -179,3 +179,11 @@ def array_to_bytes(buff):
         return buff.tostring()
 
     return buff.tobytes()
+
+def get_variant_id():
+    """
+    Get the variant ID of the distribution.
+    The variant ID is a more specific identifier of the distribution, which is used to differentiate between different variants of the same distribution.
+    For example, for Azure Container Linux, the variant ID is "azurecontainerlinux", which differentiates it from other variants of AzureLinux.
+    """
+    return distro.os_release_attr("variant_id")
