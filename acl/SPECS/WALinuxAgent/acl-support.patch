diff --git a/init/acl/waagent.service b/init/acl/waagent.service
new file mode 100644
index 0000000..4196d3c
--- /dev/null
+++ b/init/acl/waagent.service
@@ -0,0 +1,21 @@
+[Unit]
+Description=Microsoft Azure Linux Agent (ACL)
+Wants=network-online.target sshd.service sshd-keygen.service
+After=network-online.target sshd-keygen.service systemd-sysext.service
+
+[Service]
+Type=simple
+
+# Symlink the config if it's missing in /etc. This is a workaround for
+# sysext delivery (sysext overlays /usr; /etc is a writable overlay).
+#ExecStartPre=/bin/bash -c 'if [[ ! -e /etc/waagent.conf ]]; then ln -sf ../usr/share/waagent/waagent.conf /etc/waagent.conf; fi'
+#ExecStartPre=/bin/bash -c 'if [[ ! -e /oem/waagent.conf ]]; then ln -sf /etc/waagent.conf /oem/waagent.conf; fi'
+
+Environment=PYTHONUNBUFFERED=x
+ExecStart=/usr/bin/waagent -daemon
+
+Restart=always
+RestartSec=5s
+
+[Install]
+WantedBy=multi-user.target
diff --git a/setup.py b/setup.py
index fc589e1..78a8f25 100755
--- a/setup.py
+++ b/setup.py
@@ -28,7 +28,7 @@ from setuptools.command.install import install as _install
 from azurelinuxagent.common.osutil import get_osutil
 from azurelinuxagent.common.version import AGENT_NAME, AGENT_VERSION, \
     AGENT_DESCRIPTION, \
-    DISTRO_NAME, DISTRO_VERSION, DISTRO_FULL_NAME
+    DISTRO_NAME, DISTRO_VERSION, DISTRO_FULL_NAME, DISTRO_VARIANT_ID
 
 root_dir = os.path.dirname(os.path.abspath(__file__))  # pylint: disable=invalid-name
 os.chdir(root_dir)
@@ -87,7 +87,7 @@ def set_udev_files(data_files, dest="/etc/udev/rules.d/", src=None):
     data_files.append((dest, src))
 
 
-def get_data_files(name, version, fullname):  # pylint: disable=R0912
+def get_data_files(name, version, fullname, variant_id):  # pylint: disable=R0912
     """
     Determine data_files according to distro name, version and init system type
     """
@@ -149,12 +149,21 @@ def get_data_files(name, version, fullname):  # pylint: disable=R0912
                           src=["init/clearlinux/waagent.service"])
     elif name in ["mariner", "azurelinux"]:
         set_bin_files(data_files, dest=agent_bin_path)
-        set_conf_files(data_files, dest="/etc",
-                       src=["config/mariner/waagent.conf"])
-        set_systemd_files(data_files, dest=systemd_dir_path,
-                          src=["init/mariner/waagent.service"])
         set_logrotate_files(data_files)
-        set_udev_files(data_files)
+        if variant_id == "azurecontainerlinux":
+            set_conf_files(data_files, dest="/etc",
+                          src=["config/acl/waagent.conf"])
+            set_systemd_files(data_files, dest=systemd_dir_path,
+                                          src=["init/acl/waagent.service"])
+            multi_user_target_drop_in_dir = f"{systemd_dir_path}/multi-user.target.d"
+            set_systemd_files(data_files, dest=multi_user_target_drop_in_dir,
+                              src=["init/acl/10-waagent-sysext.conf"])
+        else:
+            set_conf_files(data_files, dest="/etc",
+                        src=["config/mariner/waagent.conf"])
+            set_systemd_files(data_files, dest=systemd_dir_path,
+                            src=["init/mariner/waagent.service"])
+            set_udev_files(data_files)
     elif name == 'ubuntu':
         set_conf_files(data_files, src=["config/ubuntu/waagent.conf"])
         set_logrotate_files(data_files)
@@ -277,6 +286,7 @@ class install(_install):  # pylint: disable=C0103
         ('lnx-distro=', None, 'target Linux distribution'),
         ('lnx-distro-version=', None, 'target Linux distribution version'),
         ('lnx-distro-fullname=', None, 'target Linux distribution full name'),
+        ('lnx-distro-variant-id=', None, 'target Linux distribution variant ID'),
         ('register-service', None, 'register as startup service and start'),
         ('skip-data-files', None, 'skip data files installation'),
     ]
@@ -287,6 +297,7 @@ class install(_install):  # pylint: disable=C0103
         self.lnx_distro = DISTRO_NAME
         self.lnx_distro_version = DISTRO_VERSION
         self.lnx_distro_fullname = DISTRO_FULL_NAME
+        self.lnx_distro_variant_id = DISTRO_VARIANT_ID
         self.register_service = False
         # All our data files are system-wide files that are not included in the egg; skip them when
         # creating an egg.
@@ -300,7 +311,7 @@ class install(_install):  # pylint: disable=C0103
             return
 
         data_files = get_data_files(self.lnx_distro, self.lnx_distro_version,
-                                    self.lnx_distro_fullname)
+                                    self.lnx_distro_fullname, self.lnx_distro_variant_id)
         self.distribution.data_files = data_files
         self.distribution.reinitialize_command('install_data', True)
 
