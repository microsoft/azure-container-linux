From: Mitch Zhu <mitchzhu@microsoft.com>
Date: Tue, 10 Nov 2026 00:44:21 +0000
Subject: [PATCH] esp: preserve chained EFI boot files across updates

ARM64 ACL images with SMBIOS profile selection add the selector, a separate
systemd-boot binary, and the signed Grace addon directly in EFI/BOOT.
Trident's fixed boot-file list omits these additional EFI files.

Include them in slot setup so the existing file-based update, fallback,
and bootstrap flows preserve the boot chain.
---
diff --git a/crates/trident/src/subsystems/esp.rs b/crates/trident/src/subsystems/esp.rs
index a47c2cb..a98684a 100644
--- a/crates/trident/src/subsystems/esp.rs
+++ b/crates/trident/src/subsystems/esp.rs
@@ -862,6 +862,31 @@ fn generate_boot_filepaths(temp_mount_dir: &Path, is_uki: bool) -> Result<Vec<Pa
     );
     paths.push(boot_efi_path);

+    // Chained loaders need their additional EFI applications and addon templates.
+    let boot_dir = temp_mount_dir.join(EFI_DEFAULT_BIN_RELATIVE_PATH);
+    let mut additional_paths = Vec::new();
+    for entry in fs::read_dir(&boot_dir).context("Failed to enumerate EFI boot resources")? {
+        let entry = entry?;
+        let name = entry.file_name();
+        if [BOOT_EFI, GRUB_EFI, GRUB_NOPREFIX_EFI]
+            .iter()
+            .any(|known| name.to_string_lossy().eq_ignore_ascii_case(known))
+        {
+            continue;
+        }
+        let path = entry.path();
+        if entry.file_type()?.is_file()
+            && path
+                .extension()
+                .and_then(|extension| extension.to_str())
+                .is_some_and(|extension| extension.eq_ignore_ascii_case("efi"))
+        {
+            additional_paths.push(path);
+        }
+    }
+    additional_paths.sort();
+    paths.extend(additional_paths);
+
     Ok(paths)
 }

@@ -1440,6 +1465,47 @@ mod tests {
         }
     }

+    #[test]
+    fn test_chained_boot_resources_survive_update_and_fallback() {
+        let image = TempDir::new().unwrap();
+        let image_boot = image.path().join(EFI_DEFAULT_BIN_RELATIVE_PATH);
+        fs::create_dir_all(&image_boot).unwrap();
+        let resources = [
+            BOOT_EFI,
+            GRUB_EFI,
+            "smbios-profile-selector.efi",
+            "3rdaa64.efi",
+            "nvidia-grace.addon.efi",
+        ];
+        for name in resources {
+            fs::write(image_boot.join(name), name.as_bytes()).unwrap();
+        }
+        fs::create_dir(image_boot.join("ignored.efi")).unwrap();
+        fs::write(image_boot.join("ignored.txt"), "ignored").unwrap();
+
+        let esp = TempDir::new().unwrap();
+        let slot = esp.path().join("EFI/AZLB");
+        let paths = generate_boot_filepaths(image.path(), true).unwrap();
+        assert_eq!(paths.len(), resources.len());
+        copy_boot_files(image.path(), &slot, paths).unwrap();
+        let fallback = esp.path().join(EFI_DEFAULT_BIN_RELATIVE_PATH);
+        fs::create_dir_all(&fallback).unwrap();
+        fs::write(fallback.join("nvidia-grace.addon.efi.new"), "stale").unwrap();
+        fs::write(fallback.join("nvidia-grace.addon.efi"), "old").unwrap();
+        fs::write(fallback.join("nvidia-grace.addon.efi.old"), "older").unwrap();
+        replace_boot_files(&slot, &fallback).unwrap();
+        bootstrap_azla_from_fallback(esp.path()).unwrap();
+
+        for root in [slot, fallback.clone(), esp.path().join("EFI/AZLA")] {
+            for name in resources {
+                assert_eq!(fs::read(root.join(name)).unwrap(), name.as_bytes());
+            }
+        }
+        assert!(!fallback.join("nvidia-grace.addon.efi.old").exists());
+        assert!(!fallback.join("nvidia-grace.addon.efi.old.old").exists());
+        assert!(!fallback.join("nvidia-grace.addon.efi.new").exists());
+    }
+
     #[test]
     fn test_bootstrap_azla_from_fallback() {
         let esp_dir = TempDir::new().unwrap();
