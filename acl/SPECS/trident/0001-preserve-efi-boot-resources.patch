+fn copy_boot_entry(from: &Path, to: &Path) -> Result<(), Error> {
+    if fs::symlink_metadata(from)?.is_dir() {
+        // A failed earlier copy must not leave stale files in the replacement tree.
+        if to.is_dir() {
+            fs::remove_dir_all(to)?;
+        } else if to.exists() {
+            fs::remove_file(to)?;
+        }
+        fs::create_dir_all(to)?;
+        for entry in fs::read_dir(from)? {
+            let entry = entry?;
+            copy_boot_entry(&entry.path(), &to.join(entry.file_name())).with_context(|| {
+                format!("Failed to copy boot entry '{}'", entry.path().display())
+            })?;
+        }
+    } else {
+        fs::copy(from, to)?;
+    }
+    Ok(())
+}
