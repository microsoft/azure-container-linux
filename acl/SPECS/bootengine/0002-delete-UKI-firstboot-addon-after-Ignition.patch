From 8cd08045b19026fc357c25140a8325f3c07edab0 Mon Sep 17 00:00:00 2001
From: Lanze Liu <lanzeliu@microsoft.com>
Date: Tue, 3 Mar 2026 05:03:08 +0000
Subject: [PATCH] ignition-quench: tolerate missing marker and delete UKI addon

In UKI mode Ignition's first-boot trigger is a firstboot.addon.efi on
the ESP (systemd-boot appends its `flatcar.first_boot=detected` to the
kernel cmdline). Extend ignition-quench to also remove that addon, and
downgrade the "no marker/addon found" case to a no-op: Ignition's own
re-run gate is upstream (cmdline OR marker) and both are cleaned here,
so blocking the boot on a missing input creates false failures.
---
 dracut/30ignition/ignition-quench.service | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/dracut/30ignition/ignition-quench.service b/dracut/30ignition/ignition-quench.service
index 6460917..f56f2a3 100644
--- a/dracut/30ignition/ignition-quench.service
+++ b/dracut/30ignition/ignition-quench.service
@@ -14,6 +14,6 @@ After=sysroot-boot.service

 [Service]
 Type=oneshot
-# We will only run if GRUB detected this file. Fail if we are unable to
-# remove it, rather than risking rerunning Ignition at next boot.
-ExecStart=/bin/sh -c 'if [ ! -e /sysroot/boot/flatcar/first_boot ] && [ ! -e /sysroot/boot/coreos/first_boot ]; then echo "error: /sysroot/boot/(flatcar|coreos)/first_boot not found"; exit 1; else rm -f /sysroot/boot/flatcar/first_boot /sysroot/boot/coreos/first_boot; fi'
+# Remove both the legacy GRUB marker and the UKI firstboot addon (either
+# path arms Ignition on next boot). Missing input is not fatal.
+ExecStart=/bin/sh -c 'for f in /sysroot/boot/flatcar/first_boot /sysroot/boot/coreos/first_boot; do [ -e "$f" ] && rm -f "$f"; done; for addon in /sysroot/boot/EFI/Linux/*.efi.extra.d/firstboot.addon.efi; do [ -e "$addon" ] && rm -f "$addon"; done; exit 0'
--
2.45.4
